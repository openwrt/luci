{
	"tags": {
		"allowUnknownTags": true,
		"dictionaries": [
			"jsdoc",
			"closure"
		]
	},
	"source": {
		"include": [
			"modules/luci-base/htdocs/luci-static/resources"
		],
		"includePattern": ".+\\.js(doc|x)?$"
	},
	"plugins": [
		"plugins/markdown"
	],
	"templates": {
		"cleverLinks": true,
		"monospaceLinks": true,
		"default": {
			"outputSourceFiles": true,
			"staticFiles": {
				"include": [
					"doc_gen/include"
				]
			}
		}
	},
	"opts": {
		"template": "node_modules/clean-jsdoc-theme",
		"destination": "docs/jsapi",
		"recurse": true,
		"readme": "doc_gen/README.md",
		"tutorials": "doc_gen/tutorials",
		"siteName": "LuCI Documentation",
		"basePath": "/luci/jsapi",
		"sectionOrder": [
			"Tutorials",
			"Modules",
			"Classes",
			"Externals",
			"Globals"
		],
		"favicon": "doc_gen/include/favicon.png",
		"customCssFile": "./doc_gen/extra.css",
		"menu": [
			{
				"title": "GitHub Project Page",
				"link": "https://github.com/openwrt/luci",
				"icon": "simpleicons:github"
			}
		],
		"siteUrl": "https://openwrt.github.io"
	},
	"markdown": {
		"hardwrap": false,
		"idInHeadings": true
	}
}
