#: applications/luci-app-statistics/root/usr/share/luci/statistics/plugins/thermal.json:2
msgid "Thermal"
msgstr "Termisk"

#: applications/luci-app-statistics/htdocs/luci-static/resources/view/statistics/plugins/thermal.js:7
msgid "Thermal Plugin Configuration"
msgstr "Konfiguration av Thermal-insticksmodulen"

#: applications/luci-app-statistics/htdocs/luci-static/resources/view/statistics/plugins/contextswitch.js:7
msgid "This plugin collects statistics about the processor context switches."
msgstr ""
"Den här insticksmodulen samlar in statistik om processorns kontextväxlingar."

#: applications/luci-app-statistics/htdocs/luci-static/resources/view/statistics/plugins/cpufreq.js:7
msgid "This plugin collects statistics about the processor frequency scaling."
msgstr ""
"Den här insticksmodulen samlar in statistik om processorns frekvensskalning."

#: applications/luci-app-statistics/htdocs/luci-static/resources/view/statistics/plugins/network.js:33
msgid ""
"This section defines on which interfaces collectd will wait for incoming "
"connections."
msgstr ""
"Det här avsnittet anger vilka gränssnitt collectd ska vänta på inkommande "
"anslutningar på."

#: applications/luci-app-statistics/htdocs/luci-static/resources/view/statistics/plugins/network.js:51
msgid ""
"This section defines to which servers the locally collected data is sent to."
msgstr ""
"Det här avsnittet anger vilka servrar lokalt insamlade data ska skickas till."

