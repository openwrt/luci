#!/bin/sh
# Render one screen of the built-in renderer for the LuCI editor, without touching the display.
#
#   luci-preview SCREEN DEMO CONF [key=value ...]
#
# SCREEN  1-based screen number in CONF
# DEMO    1 = made-up traffic and clients (the traffic sampler may not be running), 0 = live traffic file
# CONF    the layout in the flat key=value format of /var/run/utr-lcd/screens.conf (unsaved editor
#         state), with lines separated by \037 (unit separator) instead of newlines: LuCI's
#         exec_direct backslash-escapes whitespace in arguments, and this keeps the whole
#         config one safe token whatever cgi-exec makes of an escaped newline
# key=value  overrides of what collect.sh reports, for what-if previews (up_state=down, vpn_state=up, ...)
#
# Prints the picture as run-length text (see write_rle in lcd-status.c). Read-only; BusyBox ash.
LIBEXEC=/usr/libexec/utr-lcd
SCREEN=${1:-1}; DEMO=${2:-0}; CONF=${3:-}
shift 3 2>/dev/null

T=$(mktemp -d /tmp/utr-lcd-preview.XXXXXX) || exit 1
trap 'rm -rf "$T"' EXIT INT TERM

printf '%s' "$CONF" | tr '\037' '\n' > "$T/screens.conf"
printf '\n' >> "$T/screens.conf"
: > "$T/ovr"
for kv in "$@"; do
	case "$kv" in [a-z]*=*) printf '%s\n' "$kv" >> "$T/ovr" ;; esac
done

TRAFFIC=/var/run/utr-lcd/traffic
if [ "$DEMO" = 1 ]; then
	TRAFFIC=$T/traffic
	now=$(cut -d' ' -f1 /proc/uptime)
	# simulated split of the demo traffic between the two WANs (tsim= override from the editor)
	TSIM=eth
	for kv in "$@"; do case "$kv" in tsim=*) TSIM=${kv#tsim=} ;; esac; done
	case "$TSIM" in
		wifi)     W0D=9800000;  W0U=1400000; W1D=700000;   W1U=300000 ;;
		bal)      W0D=5200000;  W0U=800000;  W1D=7300000;  W1U=900000 ;;
		wifionly) W0D=11800000; W0U=1700000; W1D=0;        W1U=0 ;;
		ethonly)  W0D=0;        W0U=0;       W1D=12500000; W1U=1800000 ;;
		*)        W0D=2100000;  W0U=600000;  W1D=10400000; W1U=1200000 ;;
	esac
	cat > "$TRAFFIC" <<DEMO
t=$now
down_bps=$((W0D + W1D))
up_bps=$((W0U + W1U))
down_total=3200000000
up_total=500000000
uplink=phy0-sta0|$W0D|$W0U|2000000000|300000000
uplink=wan|$W1D|$W1U|1200000000|200000000
client=de:f6:15:22:44:8d|iPhone|5200000|1800000000|1|-25|4200000|1000000|1500000000|300000000
client=7c:0a:3f:ef:9f:60|Romans-Air|4900000|1100000000|1|-17|3900000|1000000|900000000|200000000
client=LAN|LAN|1600000|300000000|1||1300000|300000|240000000|60000000
client=aa:bb:cc:00:11:22|Pixel 8|500000|50000000|1|-61|300000|200000|30000000|20000000
client=aa:bb:cc:00:11:33|Smart TV|200000|400000000|1|-48|180000|20000|380000000|20000000
client=aa:bb:cc:00:11:44|Kindle|50000|20000000|1|-70|40000|10000|15000000|5000000
client=aa:bb:cc:00:11:55|Printer|20000|10000000|1|-82|15000|5000|8000000|2000000
DEMO
fi

# the collector: the real one, with the overrides applied (keys not reported are added)
COLLECT="$LIBEXEC/collect.sh | awk -v ovr=$T/ovr 'BEGIN { while ((getline l < ovr) > 0) { k = l; sub(/=.*/, \"\", k); o[k] = substr(l, length(k) + 2) } } { k = \$0; sub(/=.*/, \"\", k); if (k in o) { print k \"=\" o[k]; used[k] = 1 } else print } END { for (k in o) if (!(k in used)) print k \"=\" o[k] }'"

ROT=""; [ "$(uci -q get utr-lcd.main.rotate)" = 0 ] && ROT=-0
LCD_TRAFFIC_ANY_AGE=1 ${UTR_LCD_BIN:-/usr/bin/utr-lcd-status} -P $ROT -N "$SCREEN" -C "$T/screens.conf" -T "$TRAFFIC" -c "$COLLECT"
