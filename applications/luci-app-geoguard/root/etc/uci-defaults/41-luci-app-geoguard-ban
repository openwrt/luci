#!/bin/sh
# 41-luci-app-geoguard-ban: fresh install stays inert (guard off until the
# user enables it in the UI); upgrade with guard previously enabled
# regenerates the guard and restores the procd service (runs once).
# (No chmod: helpers and init script already ship executable in the tree.)
if [ "$(uci -q get geoguard.main.ban_enabled 2>/dev/null)" != "1" ]; then
  logger -t geoguard "ban installed, guard stays off until enabled in the UI"
  exit 0
fi
# generate the guard from the live WAN interface,
# then enable/start the procd service (runs once at install).
/usr/bin/geoguard-ban-guard >/dev/null 2>&1
/etc/init.d/geoguard-ban enable
/etc/init.d/geoguard-ban start
logger -t geoguard "ban installed, guard generated"
/etc/init.d/firewall reload >/dev/null 2>&1
exit 0
