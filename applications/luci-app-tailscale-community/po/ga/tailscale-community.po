#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:70
msgid "%s failed"
msgstr "Theip ar %s"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:94
msgid "(Experimental) Reduce Memory Usage"
msgstr "(Turgnamhach) Laghdaigh Úsáid Cuimhne"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:763
msgid "1. Enable \"Advertise Exit Node\"."
msgstr "1. Cumasaigh \"Fógair Nód Scoir\"."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:745
msgid "1. Select \"Accept Routes\" (to access remote devices)."
msgstr ""
"1. Roghnaigh \"Glac le Bealaí\" (chun rochtain a fháil ar ghléasanna "
"iargúlta)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:764
msgid ""
"2. Click \"Auto Configure Firewall\" (it forwards Tailscale traffic to WAN)."
msgstr ""
"2. Cliceáil \"Cumraigh an Balla Dóiteáin go Uathoibríoch\" (cuireann sé "
"trácht Tailscale ar aghaidh chuig an WAN)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:746
msgid ""
"2. In \"Advertise Routes\", select your local subnet (to allow remote "
"devices to access this LAN)."
msgstr ""
"2. I \"Bealaí a Fhógairt\", roghnaigh do fho-líonra áitiúil (chun ligean do "
"ghléasanna iargúlta rochtain a fháil ar an LAN seo)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:747
msgid "3. Click \"Auto Configure Firewall\" (to allow traffic forwarding)."
msgstr ""
"3. Cliceáil \"Cumraigh Balla Dóiteáin Uathoibríoch\" (chun ligean do thrácht "
"a atreorú)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:765
msgid ""
"3. In the Tailscale admin console, edit this device under the route settings "
"and approve it as an Exit Node."
msgstr ""
"3. I gconsól riaracháin Tailscale, déan an gléas seo a chur in eagar faoi na "
"socruithe bealaigh agus ceadaigh é mar Nód Scoir."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:770
msgid "4. On the client, set this device as its exit node."
msgstr "4. Ar an gcliant, socraigh an gléas seo mar a nód imeachta."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:78
msgid "Accept Routes"
msgstr "Glac le Bealaí"

