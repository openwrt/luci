msgstr "Tűzfalbeállítás letiltása"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:82
msgid "Disable SNAT"
msgstr "SNAT letiltása"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:82
msgid ""
"Disable Source NAT (SNAT) for traffic to advertised routes. Most users "
"should leave this unchecked."
msgstr ""
"A forrás NAT (SNAT) letiltása a hirdetett útvonalakra irányuló forgalomnál. "
"A legtöbb felhasználónak jelöletlenül kell hagynia."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:86
msgid "Disable Tailscale netfilter auto-configuration (--netfilter-mode=off)."
msgstr ""
"A Tailscale netfilter automatikus beállításának letiltása (--netfilter-"
"mode=off)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:85
#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:411
msgid "Disabled"
msgstr "Letiltva"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:85
msgid "Disabled: system DNS only."
msgstr "Letiltva: csak a rendszer DNS-e."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:803
msgid "Disconnect from Tailscale and expire current node key."
msgstr "Leválasztás a Tailscale-ről és a jelenlegi csomópontkulcs lejáratása."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:64
msgid "Empty reply from server"
msgstr "Üres válasz a szervertől"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:87
msgid "Enable Peer Relay"
msgstr "Peer-közvetítő engedélyezése"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:84
msgid "Enable Tailscale SSH"
msgstr "Tailscale SSH engedélyezése"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:76
msgid "Enable Tailscale Service"
msgstr "Tailscale-szolgáltatás engedélyezése"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:81
msgid "Enable Web Interface"
msgstr "Webes felület engedélyezése"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:76
msgid ""
"Enable or disable the Tailscale service. Turning it off here stops the "
"daemon and disables autostart; turning it back on starts it again."
msgstr ""
"A Tailscale-szolgáltatás engedélyezése vagy letiltása. Itt kikapcsolva leáll "
"a szolgáltatás, és letiltódik az automatikus indítás; visszakapcsolva újra "
"elindul."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:87
msgid ""
"Enable this device as a Peer Relay server. Requires a public IP and an UDP "
"port open on the router."
msgstr ""
"Az eszköz peer-közvetítő szerverként való engedélyezése. Nyilvános IP-cím és "
"a routeren megnyitott UDP-port szükséges hozzá."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:411
msgid "Enabled"
msgstr "Engedélyezve"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:94
msgid ""
"Enabling this option can reduce memory usage, but it may sacrifice some "
"performance (set GOGC=10)."
msgstr ""
"A beállítás engedélyezése csökkentheti a memóriahasználatot, de ronthatja a "
"teljesítményt (GOGC=10 beállítása)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:839
msgid "Error"
msgstr "Hiba"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:332
