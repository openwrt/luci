#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:70
msgid "%s failed"
msgstr "%s sikertelen"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:94
msgid "(Experimental) Reduce Memory Usage"
msgstr "(Kísérleti) memóriahasználat csökkentése"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:763
msgid "1. Enable \"Advertise Exit Node\"."
msgstr "1. Engedélyezze a \"Kilépő csomópont hirdetése\" lehetőséget."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:745
msgid "1. Select \"Accept Routes\" (to access remote devices)."
msgstr ""
"1. Válassza az \"Útvonalak elfogadása\" lehetőséget (a távoli eszközök "
"eléréséhez)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:764
msgid ""
"2. Click \"Auto Configure Firewall\" (it forwards Tailscale traffic to WAN)."
msgstr ""
"2. Kattintson a \"Tűzfal automatikus beállítása\" gombra (ez a Tailscale-"
"forgalmat a WAN felé továbbítja)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:746
msgid ""
"2. In \"Advertise Routes\", select your local subnet (to allow remote "
"devices to access this LAN)."
msgstr ""
"2. Az \"Útvonalak hirdetése\" mezőben válassza ki a helyi alhálózatot (hogy "
"a távoli eszközök elérjék ezt a LAN-t)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:747
msgid "3. Click \"Auto Configure Firewall\" (to allow traffic forwarding)."
msgstr ""
"3. Kattintson a \"Tűzfal automatikus beállítása\" gombra (a forgalom "
"továbbításának engedélyezéséhez)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:765
msgid ""
"3. In the Tailscale admin console, edit this device under the route settings "
"and approve it as an Exit Node."
msgstr ""
"3. A Tailscale felügyeleti konzolján szerkessze ezt az eszközt az "
"útvonalbeállításoknál, és hagyja jóvá kilépő csomópontként."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:770
msgid "4. On the client, set this device as its exit node."
msgstr "4. A kliensen állítsa be ezt az eszközt kilépő csomópontként."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:78
msgid "Accept Routes"
msgstr "Útvonalak elfogadása"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:777
msgid "Account Settings"
msgstr "Fiókbeállítások"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:79
msgid "Advertise Exit Node"
msgstr "Kilépő csomópont hirdetése"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:678
msgid "Advertise Routes"
msgstr "Útvonalak hirdetése"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:678
msgid ""
"Advertise subnet routes behind this device. Select from the detected subnets "
"below or enter custom routes (comma-separated)."
msgstr ""
"Az eszköz mögötti alhálózati útvonalak hirdetése. Válasszon a lenti "
"felismert alhálózatok közül, vagy adjon meg egyéni útvonalakat (vesszővel "
"elválasztva)."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:80
msgid "Allow LAN Access"
msgstr "LAN-hozzáférés engedélyezése"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:78
msgid "Allow accepting routes announced by other nodes."
msgstr ""
"A más csomópontok által hirdetett útvonalak elfogadásának engedélyezése."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:84
msgid "Allow connecting to this device through the SSH function of Tailscale."
msgstr ""
"Csatlakozás engedélyezése ehhez az eszközhöz a Tailscale SSH funkcióján "
"keresztül."

#: applications/luci-app-tailscale-community/root/usr/share/rpcd/acl.d/luci-app-tailscale-community.json:3
msgid "Allow user access to tailscale"
msgstr "Felhasználói hozzáférés engedélyezése a tailscale-hez"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:230
msgid "Another firewall reload is already running"
msgstr "Már fut egy másik tűzfal-újratöltés"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:851
msgid "Are you sure you want to log out?"
msgstr "Biztosan kijelentkezik?"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:686
msgid "Auto Configure Firewall"
msgstr "Tűzfal automatikus beállítása"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:858
msgid "Cancel"
msgstr "Mégse"

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:894
msgid "Click Refresh to load logs."
msgstr "A naplók betöltéséhez kattintson a Frissítés gombra."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:802
msgid "Click to Log out account on this device."
msgstr "Kattintson a fiók kijelentkeztetéséhez ezen az eszközön."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:781
msgid "Click to get a login URL for this device."
msgstr "Kattintson az eszköz bejelentkezési URL-jének lekéréséhez."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:351
#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:445
#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:633
#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:904
msgid "Collecting data ..."
msgstr "Adatok gyűjtése ..."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:722
msgid ""
"Configuration committed, reloading network and firewall. This can take a "
"moment."
msgstr ""
"A beállítások véglegesítve, a hálózat és a tűzfal újratöltése folyamatban. "
"Ez eltarthat egy ideig."

#: applications/luci-app-tailscale-community/htdocs/luci-static/resources/view/tailscale.js:715
