{
	"luci-app-wifihistory": {
		"description": "Grant access to WiFi station history",
		"read": {
			"ubus": {
				"iwinfo": [ "assoclist" ],
				"luci.wifihistory": [ "getHistory", "getStatus" ]
			},
			"uci": [ "wifihistory" ]
		},
		"write": {
			"ubus": {
				"luci.wifihistory": [ "clearHistory" ]
			},
			"uci": [ "wifihistory" ]
		}
	}
}
