#!/usr/bin/env ucode

'use strict';

import { readfile, writefile, mkdir, unlink, stat, error } from 'fs';
import { connect } from 'ubus';
import { load_file, save_file } from 'wifihistory.json-file';
import {
	RAM_DIR, HISTORY_NAME, storage_status, persistent_dir, save_interval,
	acquire_lock, ensure_storage_dir
} from 'wifihistory.storage';
import {
	read_clear_marker, complete_pending_clear
} from 'wifihistory.recovery';

/* The working copy always lives in RAM. It is mirrored to the persistent
 * storage (if configured and mounted) on connection changes, periodically
 * and when the service stops, to keep writes to flash media low. */
const HISTORY_DIR = RAM_DIR;
const HISTORY_FILE = HISTORY_DIR + '/' + HISTORY_NAME;

/* Holds the storage path the history was last restored from in this boot */
const RESTORE_MARKER = '/var/run/wifihistory.restored';
const CLEAR_MARKER = '/etc/wifihistory.clear-pending';
const STOP_MARKER = '/var/run/wifihistory.stopping';

/* Combine two histories, the record with the newest last_seen wins */
function merge_history(base, update) {
	let out = {};

	for (let mac, rec in base)
		out[mac] = rec;

	for (let mac, rec in update) {
		let cur = out[mac];

		if (!cur) {
			out[mac] = rec;
			continue;
		}

		let newer = ((rec.last_seen || 0) >= (cur.last_seen || 0)) ? rec : cur;
		let a = cur.first_seen || 0;
		let b = rec.first_seen || 0;

		newer.first_seen = (a && b) ? (a < b ? a : b) : (a || b);
		out[mac] = newer;
	}

	return out;
}

/* Load the persisted history into the RAM working copy */
function restore(dir) {
	let persisted = load_file(dir + '/' + HISTORY_NAME);
	if (!persisted.ok)
		return;

	let ram = load_file(HISTORY_FILE);
	if (!ram.ok)
		return;

	/* nobody is connected right after (re)start, polling will fix it */
	for (let mac, rec in persisted.data)
		rec.connected = false;

	let merged = merge_history(persisted.data, ram.data);

	if (!save_file(HISTORY_FILE, merged))
		return;

	if (writefile(RESTORE_MARKER, dir) == null)
		warn(sprintf('Failed to write restore marker: %s\n', error()));
}

/* Make sure persistent storage is initialised; handles storage that
 * is mounted late, replaced or unplugged. */

function sync_storage() {
	let marker = read_clear_marker(CLEAR_MARKER);

	if (!marker.ok)
		return false;

	if (marker.pending) {
		let configured_path = storage_status().path;
		let dir = persistent_dir();

		/* Only prepare the storage directory that was recorded
		 * when the clear operation started. */
		if (dir && dir == marker.data.storage_path &&
		    !ensure_storage_dir())
			dir = null;

		return complete_pending_clear(CLEAR_MARKER, HISTORY_FILE,
			RESTORE_MARKER, dir, configured_path);
	}

	if (!ensure_storage_dir()) {
		unlink(RESTORE_MARKER);
		return true;
	}

	let dir = persistent_dir();

	if (!dir) {
		unlink(RESTORE_MARKER);
		return true;
	}

	if (readfile(RESTORE_MARKER) != dir)
		restore(dir);

	return true;
}


function persist(history, force) {
	let marker = read_clear_marker(CLEAR_MARKER);

	/* Never persist while a clear operation is pending or its marker
	 * cannot be read safely. */
	if (!marker.ok || marker.pending)
		return;

	let dir = persistent_dir();

	/* Never overwrite persistent data unless it was restored successfully. */
	if (!dir || readfile(RESTORE_MARKER) != dir)
		return;

	let target = dir + '/' + HISTORY_NAME;
	let stored = load_file(target);

	/* Do not overwrite existing data if it cannot be read or parsed. */
	if (!stored.ok) {
		warn('Cannot inspect persistent history; skipping save\n');
		return;
	}

	/* A missing history file is safe to create. */
	if (!stored.exists) {
		save_file(target, history);
		return;
	}

	let info = stat(target);
	if (!info) {
		warn(sprintf('Cannot stat persistent history %s: %s\n',
			target, error()));
		return;
	}

	let age = time() - info.mtime;

	/* negative age: clock was corrected, do not wait for it to catch up */
	if (force || age < 0 || age >= save_interval())
		save_file(target, history);
}

/* Unconditionally write the RAM copy to the storage (used on stop) */

function flush() {
	let marker = read_clear_marker(CLEAR_MARKER);

	/* Never flush while a clear operation is pending or its marker
	 * cannot be read safely. */
	if (!marker.ok || marker.pending)
		return;

	let dir = persistent_dir();

	/* never overwrite stored data with a history that was not restored */
	if (!dir || readfile(RESTORE_MARKER) != dir)
		return;

	let history = load_file(HISTORY_FILE);
	if (!history.ok) {
		warn('Cannot flush invalid or unreadable RAM history\n');
		return;
	}

	save_file(dir + '/' + HISTORY_NAME, history.data);
}

function poll_stations() {
	let loaded = load_file(HISTORY_FILE);
	if (!loaded.ok) {
		warn('Cannot poll with invalid or unreadable history\n');
		return;
	}

	let ubus = connect();
	if (!ubus) {
		warn('Failed to connect to ubus\n');
		return;
	}

	let now = time();
	let history = loaded.data;
	let seen_macs = {};
	let changed = false;

	let wifi_status = ubus.call('network.wireless', 'status');
	if (!wifi_status) {
		ubus.disconnect();
		return;
	}

	let hints = ubus.call('luci-rpc', 'getHostHints') || {};

	for (let radio in wifi_status) {
		let ifaces = wifi_status[radio]?.interfaces;
		if (!ifaces)
			continue;

		for (let iface in ifaces) {
			let ifname = iface?.ifname;
			if (!ifname)
				continue;

			let info = ubus.call('iwinfo', 'info', { device: ifname });
			let ssid = info?.ssid || '';

			let assoc = ubus.call('iwinfo', 'assoclist', { device: ifname });
			if (!assoc?.results)
				continue;

			for (let bss in assoc.results) {
				let mac = bss?.mac;
				if (!mac)
					continue;

				mac = uc(mac);
				seen_macs[mac] = true;

				let hostname = hints?.[mac]?.name || '';
				let ipv4 = hints?.[mac]?.ipaddrs?.[0] || '';
				let ipv6 = hints?.[mac]?.ip6addrs?.[0] || '';

				let existing = history[mac];
				let first_seen = existing?.first_seen || now;

				if (!existing?.connected)
					changed = true;

				history[mac] = {
					mac: mac,
					hostname: hostname,
					ipv4: ipv4,
					ipv6: ipv6,
					network: ssid,
					ifname: ifname,
					connected: true,
					signal: bss?.signal || 0,
					noise: bss?.noise || 0,
					first_seen: first_seen,
					last_seen: now
				};
			}
		}
	}

	for (let mac in history) {
		if (!seen_macs[mac]) {
			if (history[mac].connected)
				changed = true;

			history[mac].connected = false;
		}
	}

	ubus.disconnect();

	if (save_file(HISTORY_FILE, history))
		persist(history, changed);
}

mkdir(HISTORY_DIR);

/* A flush must wait until the polling instance releases the lock. */
if (ARGV[0] == 'flush') {
	let lock_fd = acquire_lock(false);

	if (!lock_fd) {
		warn('Failed to acquire history lock for flush\n');
		exit(1);
	}

	flush();
	lock_fd.close();
	exit(0);
}

/* Only one polling instance may access the history at a time. */
let lock_fd = acquire_lock(true);

if (!lock_fd) {
	warn('Another instance is already running\n');
	exit(1);
}


if (stat(STOP_MARKER)) {
	lock_fd.close();
	exit(0);
}

if (sync_storage())
	poll_stations();
else
	warn('Storage synchronisation blocked; skipping polling\n');

lock_fd.close();
