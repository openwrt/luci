msgstr "Hanteringsgränssnitt"

#: applications/luci-app-openwisp/htdocs/luci-static/resources/view/openwisp.js:92
msgid "Max Time"
msgstr "Maximal tid"

#: applications/luci-app-openwisp/htdocs/luci-static/resources/view/openwisp.js:60
