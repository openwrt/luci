msgid "Clear data for all interfaces"
msgstr "Adatok törlése az összes interfészhez"

#: applications/luci-app-vnstat2/root/usr/share/luci/menu.d/luci-app-vnstat2.json:27
msgid "Configuration"
msgstr "Beállítások"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:93
msgid "Could not load graph, no data available:"
msgstr "Nem sikerült betölteni a grafikont, nincs elérhető adat:"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:130
msgid "Daily"
msgstr "Naponta"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:26
