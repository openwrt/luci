msgstr "Hozzáférés engedélyezése a <em>vnstat2</em> LuCI alkalmazáshoz"

#: applications/luci-app-vnstat2/root/usr/share/luci/menu.d/luci-app-vnstat2.json:18
msgid "Graphs"
msgstr "Grafikonok"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:129
msgid "Hourly"
msgstr "Óránként"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:78
msgid "Interface"
msgstr "Interfész"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:45
msgid "Interfaces"
msgstr "Interfészek"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:86
msgid "Loading graphs…"
msgstr "Grafikonok betöltése…"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:49
msgid "Monitor interfaces"
msgstr "Interfészek megfigyelése"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:131
msgid "Monthly"
msgstr "Havonta"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:133
msgid ""
"No monitored interfaces have been found. Go to the configuration to enable "
"monitoring for one or more interfaces."
msgstr ""
"Nem találhatók megfigyelt interfészek. Menjen a beállításokhoz egy vagy több "
"interfész megfigyelésének engedélyezéséhez."

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:96
msgid "No unconfigured interfaces found in database."
msgstr "Nem találhatók beállítatlan interfészek az adatbázisban."

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:126
msgid "Summary"
msgstr "Összegzés"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:50
msgid ""
"The data will be removed from the database permanently. This cannot be "
"undone."
msgstr "Az adatok véglegesen törlődnek az adatbázisból. Ez nem vonható vissza."

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:16
msgid ""
"The interface will be removed from the database permanently. This cannot be "
"undone."
msgstr ""
"Az interfész véglegesen el lesz távolítva az adatbázisból. Ezt nem lehet "
"visszavonni."

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:49
msgid ""
"The selected interfaces are automatically added to the vnStat database upon "
"startup."
msgstr ""
"A kiválasztott interfészek automatikusan hozzá lesznek adva indításkor a "
"vnStat adatbázishoz."

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:101
msgid ""
"These interfaces are present in the vnStat database, but are not configured "
"above."
msgstr ""
"Ezek az interfészek jelen vannak a vnStat adatbázisban, de nincsenek "
"beállítva fent."

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:127
msgid "Top"
msgstr "Legtöbb"

#: applications/luci-app-vnstat2/root/usr/share/luci/menu.d/luci-app-vnstat2.json:3
msgid "Traffic Monitor"
msgstr "Forgalomfigyelő"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:99
msgid "Unconfigured interfaces"
msgstr "Beállítatlan interfészek"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:123
msgid "Warning: The service is not running, graphs will not be updated!"
msgstr "Figyelmeztetés: a szolgáltatás nem fut, a grafikonok nem frissülnek!"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:132
msgid "Yearly"
msgstr "Évente"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:43
msgid "vnStat"
msgstr "vnStat"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/graphs.js:121
msgid "vnStat Graphs"
msgstr "vnStat grafikonok"

#: applications/luci-app-vnstat2/htdocs/luci-static/resources/view/vnstat2/config.js:43
msgid ""
"vnStat is a network traffic monitor for Linux that keeps a log of network "
"traffic for the selected interface(s)."
msgstr ""
"A vnStat egy hálózatiforgalom-megfigyelő a Linuxhoz, amely megtartja a "
"kiválasztott interfészek hálózati forgalmának naplóját."
