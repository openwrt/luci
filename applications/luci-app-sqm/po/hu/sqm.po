#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:138
msgid "Advanced Configuration"
msgstr "Haladó beállítások"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:208
msgid "Advanced Linklayer Options"
msgstr "Haladó adatkapcsolati beállítások"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:192
msgid ""
"Advanced option string to pass to the egress queueing disciplines; no error "
"checking, use very carefully."
msgstr ""
"A kimenő sorkezelési eljárásoknak átadandó haladó beállítási karakterlánc; "
"nincs hibaellenőrzés, nagyon óvatosan használja."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:189
msgid ""
"Advanced option string to pass to the ingress queueing disciplines; no error "
"checking, use very carefully."
msgstr ""
"A bejövő sorkezelési eljárásoknak átadandó haladó beállítási karakterlánc; "
"nincs hibaellenőrzés, nagyon óvatosan használja."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:208
msgid ""
"Advanced options will only be used as long as this box is checked (only "
"needed if MTU > 1500)."
msgstr ""
"A haladó beállítások csak addig érvényesek, amíg ez a jelölőnégyzet be van "
"jelölve (csak akkor szükséges, ha az MTU > 1500)."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:138
msgid "Advanced options will only be used as long as this box is checked."
msgstr ""
"A haladó beállítások csak addig érvényesek, amíg ez a jelölőnégyzet be van "
"jelölve."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:74
msgid "Basic Settings"
msgstr "Alapbeállítások"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:105
msgid ""
"Create log file for this SQM instance under /var/run/sqm/${Interface_name}."
"[start|stop]-sqm.log."
msgstr ""
"Naplófájl létrehozása ehhez az SQM-példányhoz a /var/run/sqm/$"
"{Interface_name}.[start|stop]-sqm.log helyen."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:169
msgid "Dangerous Configuration"
msgstr "Veszélyes beállítások"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:169
msgid "Dangerous options will only be used as long as this box is checked."
msgstr ""
"A veszélyes beállítások csak addig érvényesek, amíg ez a jelölőnégyzet be "
"van jelölve."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:97
msgid "Download speed (ingress)"
msgstr "Letöltési sebesség (bejövő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:97
msgid ""
"Download speed (kbit/s) (ingress) set to 0 to disable ingress shaping "
"selectively"
msgstr ""
"Letöltési sebesség (kbit/s) (bejövő); a bejövő forgalom formálásának "
"szelektív letiltásához állítsa 0-ra"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:163
msgid "ECN (egress)"
msgstr "ECN (kimenő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:157
msgid "ECN (ingress)"
msgstr "ECN (bejövő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:60
msgid "Enable SQM"
msgstr "SQM engedélyezése"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:105
msgid "Enable debug logging"
msgstr "Hibakeresési naplózás engedélyezése"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:141
msgid "Enable multi-queue config"
msgstr "Többsoros beállítás engedélyezése"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:141
msgid ""
"Enable multi-queue qdisc on supported hardware. If .qos script does not "
"support mq this option is ignored."
msgstr ""
"Többsoros qdisc engedélyezése a támogatott hardvereken. Ha a .qos "
"parancsfájl nem támogatja az mq-t, ez a beállítás figyelmen kívül marad."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:80
msgid "Enable this SQM instance."
msgstr "Az SQM-példány engedélyezése."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:157
msgid "Explicit congestion notification (ECN) status on inbound packets"
msgstr "Explicit torlódásjelzés (ECN) állapota a bejövő csomagokon"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:163
msgid "Explicit congestion notification (ECN) status on outbound packets"
msgstr "Explicit torlódásjelzés (ECN) állapota a kimenő csomagokon"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:57
#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:87
msgid "Failed to enable the sqm initscript: %s"
msgstr "Nem sikerült engedélyezni az sqm indítóparancsfájlt: %s"

#: applications/luci-app-sqm/root/usr/share/rpcd/acl.d/luci-app-sqm.json:3
msgid "Grant UCI access for luci-app-sqm"
msgstr "UCI hozzáférés engedélyezése a <em>luci-app-sqm</em> alkalmazásnak"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:177
msgid "Hard limit on egress queues; leave empty for default."
msgstr "A kimenő sorok szigorú korlátja; az alapértelmezetthez hagyja üresen."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:173
msgid "Hard limit on ingress queues; leave empty for default."
msgstr "A bejövő sorok szigorú korlátja; az alapértelmezetthez hagyja üresen."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:177
msgid "Hard queue limit (egress)"
msgstr "Szigorú sorkorlát (kimenő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:173
msgid "Hard queue limit (ingress)"
msgstr "Szigorú sorkorlát (bejövő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:151
msgid "Ignore DSCP (ingress)"
msgstr "DSCP figyelmen kívül hagyása (bejövő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:151
msgid "Ignore DSCP markings on inbound packets"
msgstr "A bejövő csomagok DSCP-jelöléseinek figyelmen kívül hagyása"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:94
msgid "Interface name"
msgstr "Interfész neve"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:185
msgid "Latency target (egress)"
msgstr "Késleltetési cél (kimenő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:181
msgid "Latency target (ingress)"
msgstr "Késleltetési cél (bejövő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:185
msgid ""
"Latency target for egress, e.g. 5ms [units: s, ms, or us]; leave empty for "
"automatic selection, put in the word default for the qdisc's default."
msgstr ""
"Késleltetési cél a kimenő forgalomhoz, pl. 5ms [mértékegység: s, ms vagy "
"us]; automatikus kiválasztáshoz hagyja üresen, a qdisc alapértelmezett "
"értékéhez írja be a default szót."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:181
msgid ""
"Latency target for ingress, e.g 5ms [units: s, ms, or us]; leave empty for "
"automatic selection, put in the word default for the qdisc's default."
msgstr ""
"Késleltetési cél a bejövő forgalomhoz, pl. 5ms [mértékegység: s, ms vagy "
"us]; automatikus kiválasztáshoz hagyja üresen, a qdisc alapértelmezett "
"értékéhez írja be a default szót."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:76
msgid "Link Layer Adaptation"
msgstr "Adatkapcsolati alkalmazkodás"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:196
msgid "Link layer"
msgstr "Adatkapcsolati réteg"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:227
msgid "Linklayer adaptation mechanism"
msgstr "Adatkapcsolati alkalmazkodási mechanizmus"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:117
msgid ""
"Lists queuing disciplines useable on this system. After installing a new "
"qdisc, you need to restart the router to see updates!"
msgstr ""
"A rendszeren használható sorkezelési eljárások (qdisc) listája. Új qdisc "
"telepítése után a változások megjelenítéséhez újra kell indítani az "
"útválasztót!"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:108
msgid "Log verbosity"
msgstr "Naplózás részletessége"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:212
msgid ""
"Maximal Size for size and rate calculations, tcMTU (byte); needs to be >= "
"interface MTU + overhead"
msgstr ""
"A méret- és sebességszámítások legnagyobb mérete, tcMTU (bájt); értéke "
"legyen >= interfész MTU + többlet"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:212
msgid "Maximum packet size"
msgstr "Legnagyobb csomagméret"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:222
msgid ""
"Minimal packet size, MPU (byte); needs to be > 0 for ethernet size tables"
msgstr ""
"Legkisebb csomagméret, MPU (bájt); Ethernet-mérettáblák esetén > 0 kell "
"legyen"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:222
msgid "Minimum packet size"
msgstr "Legkisebb csomagméret"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:217
msgid ""
"Number of entries in size/rate tables, TSIZE; for ATM choose TSIZE = (tcMTU "
"+ 1) / 16"
msgstr ""
"A méret/sebesség táblák bejegyzéseinek száma, TSIZE; ATM esetén válassza a "
"TSIZE = (tcMTU + 1) / 16 értéket"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:202
msgid "Per Packet Overhead (bytes)"
msgstr "Csomagonkénti többlet (bájt)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:192
msgid "Qdisc options (egress)"
msgstr "Qdisc-beállítások (kimenő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:189
msgid "Qdisc options (ingress)"
msgstr "Qdisc-beállítások (bejövő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:75
msgid "Queue Discipline"
msgstr "Sorkezelési eljárás"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:125
msgid "Queue setup script"
msgstr "Sorbeállító parancsfájl"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:117
msgid "Queueing discipline"
msgstr "Sorkezelési eljárás"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:73
msgid "Queues"
msgstr "Sorok"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:217
msgid "Rate table size"
msgstr "Sebességtábla mérete"

#: applications/luci-app-sqm/root/usr/share/luci/menu.d/luci-app-sqm.json:3
msgid "SQM QoS"
msgstr "SQM QoS"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:66
msgid "Smart Queue Management"
msgstr "Intelligens sorkezelés"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:145
msgid "Squash DSCP (ingress)"
msgstr "DSCP törlése (bejövő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:145
msgid "Squash DSCP markings on inbound packets"
msgstr "DSCP-jelölések törlése a bejövő csomagokon"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:85
msgid ""
"The SQM GUI has just enabled the sqm initscript on your behalf. Remember to "
"disable the sqm initscript manually under System Startup menu in case this "
"change was not wished for."
msgstr ""
"Az SQM grafikus felülete az Ön nevében engedélyezte az sqm "
"indítóparancsfájlt. Ha ezt nem kívánta, ne felejtse el kézzel letiltani az "
"sqm indítóparancsfájlt a Rendszer → Rendszerindítás menüben."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:48
msgid ""
"The SQM service seems to be disabled. Please use the button below to "
"activate this service."
msgstr ""
"Úgy tűnik, az SQM-szolgáltatás le van tiltva. Kérjük, a szolgáltatás "
"aktiválásához használja az alábbi gombot."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:101
msgid "Upload speed (egress)"
msgstr "Feltöltési sebesség (kimenő)"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:101
msgid ""
"Upload speed (kbit/s) (egress) set to 0 to selectively disable egress shaping"
msgstr ""
"Feltöltési sebesség (kbit/s) (kimenő); a kimenő forgalom formálásának "
"szelektív letiltásához állítsa 0-ra"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:108
msgid "Verbosity of SQM's output into the system log."
msgstr "Az SQM rendszernaplóba írt kimenetének részletessége."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:196
msgid "Which link layer technology to account for"
msgstr "Melyik adatkapcsolati rétegbeli technológiát vegye figyelembe"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:227
msgid "Which linklayer adaptation mechanism to use; for testing only"
msgstr ""
"Melyik adatkapcsolati alkalmazkodási mechanizmust használja; csak "
"teszteléshez"

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:67
msgid ""
"With <abbr title=\"Smart Queue Management\">SQM</abbr> you can enable "
"traffic shaping, better mixing (Fair Queueing), active queue length "
"management (AQM) and prioritisation on one network interface."
msgstr ""
"Az <abbr title=\"Smart Queue Management\">SQM</abbr> segítségével egy "
"hálózati interfészen engedélyezheti a forgalomformálást, a jobb keverést "
"(Fair Queueing), az aktív sorhossz-kezelést (AQM) és a priorizálást."

#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:112
#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:158
#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:164
#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:197
#: applications/luci-app-sqm/htdocs/luci-static/resources/view/network/sqm.js:228
msgid "default"
msgstr "alapértelmezett"
