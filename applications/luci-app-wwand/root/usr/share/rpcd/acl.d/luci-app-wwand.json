{
	"luci-app-wwand": {
		"description": "Grant access to the wwand modem status page",
		"read": {
			"uci": [
				"network"
			],
			"ubus": {
				"wwand": [
					"context_status",
					"modem_cells",
					"modem_datapath",
					"modem_euicc_profiles",
					"modem_get_settings",
					"modem_plmn_lists",
					"modem_probe",
					"modem_scan",
					"modem_scan_start",
					"modem_scan_status",
					"modem_signal",
					"modem_sim_slots",
					"modem_sms_list",
					"status"
				]
			},
			"file": {
				"/sys/class/gpio/": [
					"list"
				]
			}
		},
		"write": {
			"uci": [
				"network"
			],
			"ubus": {
				"wwand": [
					"migrate",
					"modem_carrier_config",
					"modem_esim",
					"modem_plmn_restore",
					"modem_plmn_set",
					"modem_reattach",
					"modem_repower",
					"modem_reset",
					"modem_set_network_selection",
					"modem_set_protocol",
					"modem_set_settings",
					"modem_sim_pin_lock",
					"modem_sim_pin_verify",
					"modem_sim_puk",
					"modem_sim_switch_slot",
					"modem_sms_delete"
				]
			}
		}
	}
}
