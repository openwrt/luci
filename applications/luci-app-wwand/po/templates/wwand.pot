msgstr ""

#: applications/luci-app-wwand/htdocs/luci-static/resources/view/wwand/settings.js:1294
msgid ""
"Switch the modem firmware to MBIM? The modem resets and re-enumerates. Some "
"firmwares reject MBIM even though the switch itself succeeds — if the modem "
"does not come back, switch it to QMI again. A \"Control protocol\" pinned on "
"the modem page is cleared back to \"detect\", because a pin the driver "
"contradicts disables hardware recovery for this modem."
msgstr ""

#: applications/luci-app-wwand/htdocs/luci-static/resources/wwand/modemopts.js:639
msgid ""
"Switch the modem's GNSS receiver on with the vendor AT command. This is the "
"path that works on Quectel and ASR modems; the NMEA port it feeds is "
"reported as <em>gps_port</em>. Install <em>wwand-gps</em> to have ugps "
"pointed at that port automatically and the position published over ubus."
msgstr ""

#: applications/luci-app-wwand/htdocs/luci-static/resources/view/wwand/settings.js:1285
msgid "Switch to %s"
msgstr ""

#: applications/luci-app-wwand/htdocs/luci-static/resources/view/wwand/status.js:1009
#: applications/luci-app-wwand/htdocs/luci-static/resources/wwand/format.js:612
msgid "Switch to SIM slot %d? The connection will drop and re-establish."
msgstr ""

#: applications/luci-app-wwand/htdocs/luci-static/resources/view/wwand/status.js:924
msgid "TAC / Cell ID"
msgstr ""

#: applications/luci-app-wwand/htdocs/luci-static/resources/view/wwand/status.js:924
msgid ""
"TAC = Tracking Area Code (paging area); Cell ID = the network-wide unique "
"identifier of this cell"
msgstr ""

#: applications/luci-app-wwand/htdocs/luci-static/resources/view/wwand/status.js:894
