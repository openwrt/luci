{
	"luci-app-v2raya": {
		"description": "Grant access to the v2rayA service and configuration",
		"read": {
			"file": {
				"/usr/bin/v2raya": [ "exec" ],
				"/usr/bin/v2raya_core": [ "exec" ],
				"/usr/libexec/v2raya-detect": [ "exec" ],
				"/var/log/v2raya/v2raya.log": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ]
			},
			"uci": [ "v2raya" ]
		},
		"write": {
			"file": {
				"/etc/init.d/v2raya start": [ "exec" ],
				"/etc/init.d/v2raya stop": [ "exec" ],
				"/etc/init.d/v2raya restart": [ "exec" ],
				"/var/log/v2raya/v2raya.log": [ "write" ]
			},
			"uci": [ "v2raya" ]
		}
	}
}
