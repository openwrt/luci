#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:93
msgid "-1 - Restart every last day of month"
msgstr "-1 - Starta om sista dagen i varje månad"

#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:94
msgid "-7 - Restart a week before end of month"
msgstr "-7 – Starta om en vecka före månadens slut"

#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:92
msgid "1 - Restart every 1st of month"
msgstr "1 – Starta om den första dagen i varje månad"

#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:162
msgid "10m - frequent commits at the expense of flash wear"
msgstr "10 m – täta skrivningar på bekostnad av flashminnets livslängd"

#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:161
msgid "12h - compromise between risk of data loss and flash wear"
msgstr ""
"12 h – kompromiss mellan risk för dataförlust och slitage på flashminnet"

#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:160
msgid "24h - least flash wear at the expense of data loss risk"
msgstr ""
"24 h – minst slitage på flashminnet på bekostnad av större risk för "
"dataförlust"

#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:167
msgid "30s - refresh twice per minute for reasonably current stats"
msgstr "30 s – uppdatera två gånger per minut för någorlunda aktuell statistik"

#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:168
msgid "5m - rarely refresh to avoid frequently clearing conntrack counters"
msgstr ""
"5 m – uppdatera sällan för att undvika att conntrack-räknare nollställs ofta"

#: applications/luci-app-nlbwmon/htdocs/luci-static/resources/view/nlbw/config.js:163
msgid "60s - commit minutely, useful for non-flash storage"
msgstr ""
"60 s – skriv varje minut, användbart för lagring som inte är flashminne"

