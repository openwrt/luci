#!/bin/sh

# Sync /etc/notes.md to the shipped template matching the configured
# LuCI language. The file is only replaced while its content still
# equals the last applied template (recorded in STATE) or one of the
# shipped templates — once the user edits the notes, the file is left
# alone on every subsequent run.

TEMPLATE_DIR=/usr/share/luci-app-notes
BASE=$TEMPLATE_DIR/notes.md
TARGET=/etc/notes.md
STATE=/etc/.luci-app-notes-default

lang=$(uci -q get luci.main.lang)
tmpl=

if [ -n "$lang" ]; then
	# Normalize locale identifiers without using tr.
	# Some BusyBox environments incorrectly convert pt_br to wt_br
	# when using tr '[:upper:]' '[:lower:]'.
	norm=$(printf '%s' "$lang" |
		sed 'y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/; s/-/_/g')

	# Map LuCI runtime identifiers to the shipped template filenames.
	case "$norm" in
		zh_tw) mapped=zh_Hant ;;
		zh_cn) mapped=zh_Hans ;;
		pt_br) mapped=pt_BR ;;
		no|nb_no) mapped=nb_NO ;;
		bn|bn_bd) mapped=bn_BD ;;
		*) mapped=$norm ;;
	esac

	# Check original, mapped and normalized locale identifiers.
	for cand in "$BASE.$lang" "$BASE.$mapped" "$BASE.$norm"; do
		if [ -f "$cand" ]; then
			tmpl=$cand
			break
		fi
	done
fi

# Fall back to the default English template.
[ -z "$tmpl" ] && tmpl=$BASE
[ -f "$tmpl" ] || exit 0

# Never overwrite user-edited notes.
# A file is considered unmodified if it matches the previously applied
# template or any of the currently shipped templates.
if [ -f "$TARGET" ]; then
	if [ -f "$STATE" ] && cmp -s "$TARGET" "$STATE"; then
		:
	else
		untouched=0

		for cand in "$BASE" "$BASE".*; do
			[ -f "$cand" ] || continue

			if cmp -s "$TARGET" "$cand"; then
				untouched=1
				break
			fi
		done

		[ "$untouched" -eq 1 ] || exit 0
	fi
fi

# Apply the selected template and record it for future comparisons.
cp "$tmpl" "$TARGET"
cp "$tmpl" "$STATE"
