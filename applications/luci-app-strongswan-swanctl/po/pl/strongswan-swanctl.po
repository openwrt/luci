msgid "Using this option only if you know exactly what you are doing."
msgstr "Użyj tej opcji tylko wtedy, gdy dokładnie wiesz, co robisz."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1432
msgid "Using this setting may prevent future updates or migrations."
msgstr ""
