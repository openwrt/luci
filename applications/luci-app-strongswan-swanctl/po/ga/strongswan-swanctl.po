#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:526
msgid "Certificates to use for authentication."
msgstr "Teastais le húsáid le haghaidh fíordheimhnithe."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:294
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/secrets.js:183
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:161
msgid "Changes take effect once the IPsec service is enabled."
msgstr ""
"Tiocfaidh na hathruithe i bhfeidhm a luaithe a chuirfear an tseirbhís IPsec "
"i ngníomh."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:351
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1099
msgid ""
"Check the ESP Proposal option of the proposals or create the missing ones."
msgstr ""
"Seiceáil an rogha Togra ESP de na tograí nó cruthaigh na cinn atá ar "
"iarraidh."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:165
msgid "Child Details"
msgstr "Sonraí an Linbh"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:267
msgid "Child mode"
msgstr "Mód leanaí"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:283
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1023
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1107
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1364
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1402
msgid "Children"
msgstr "Leanaí"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1366
msgid "Children used by other connections cannot be deleted here."
msgstr "Ní féidir leanaí a úsáidtear i gceangail eile a scriosadh anseo."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:224
msgid ""
"Choose a range that is not used by any local network and large enough for "
"all peers that connect at the same time."
msgstr ""
"Roghnaigh raon nach n-úsáideann aon líonra áitiúil, agus atá mór go leor do "
"gach comhpháirtí a nascann ag an am céanna."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:248
msgid "Class"
msgstr "Rang"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:556
msgid "Client EAP identity to use in the EAP method."
msgstr "Aitheantas EAP an chliaint le húsáid sa mhodh EAP."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:574
msgid "Client XAuth username used in the XAuth exchange."
msgstr "Ainm úsáideora XAuth an chliaint a úsáidtear sa mhalartú XAuth."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:268
msgid ""
"Clients that support the attribute (e.g. Cisco Unity) use them to decide "
"which traffic is sent through the tunnel."
msgstr ""
"Úsáideann cliaint a thacaíonn leis an tréith (m.sh. Cisco Unity) iad chun a "
"chinneadh cén trácht a sheoltar tríd an tollán."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:324
msgid "Close Action"
msgstr "Dún Gníomh"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:141
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1028
msgid "Configuration is enabled or not"
msgstr "An bhfuil an chumraíocht cumasaithe nó nach bhfuil"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:24
msgid "Configuration management and plugins"
msgstr "Bainistíocht cumraíochta agus breiseáin"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1415
msgid ""
"Configure Cipher Suites to define IKE (Phase 1) or ESP (Phase 2) Proposals."
msgstr ""
"Cumraigh Sraith Cipher chun Tograí IKE (Céim 1) nó ESP (Céim 2) a shainiú."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:88
msgid "Configure global service parameters."
msgstr "Cumraigh paraiméadair sheirbhíse dhomhanda."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:109
msgid "Configure how strongswan logs events, errors, and debug information."
msgstr ""
"Cumraigh an chaoi a ndéanann strongswan logáil ar imeachtaí, ar earráidí "
"agus ar fhaisnéis dhífhabhtaithe."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:153
msgid "Configure the kernel-netlink plugin options."
msgstr "Cumraigh roghanna an bhreiseáin kernel-netlink."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:115
msgid ""
"Configure whether and how strongswan logs events, errors, and debug "
"information to a file."
msgstr ""
"Cumraigh cé acu an ndéanann, agus an chaoi a ndéanann, strongswan imeachtaí, "
"earráidí, agus faisnéis dhífhabhtaithe a logáil chuig comhad."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1120
msgid "Configured child sections do not exist: %s"
msgstr "Níl na fo-rannóga cumraithe ann: %s"

