#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:76
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/secrets.js:74
msgid "A file must be selected."
msgstr "Caithfear comhad a roghnú."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:236
msgid "A legacy IPsec configuration was found."
msgstr "Aimsíodh cumraíocht IPsec shean-nóis."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:191
msgid "A local file must be given as a file URI, e.g. %s."
msgstr "Ní mór comhad áitiúil a sholáthar mar URI comhaid, m.sh. %s."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:207
msgid ""
"A pool is a named range of virtual IP addresses that the IKE daemon hands "
"out to remote peers (road warriors) when they connect, so that they get an "
"address inside your network."
msgstr ""
"Is éard is \"linn\" ann ná raon ainmnithe de sheoltaí IP fíorúla a shanntar "
"ag an deamhan IKE do chomhpháirtithe cianda (úsáideoirí soghluaiste) nuair a "
"nascann siad, ionas go bhfaigheann siad seoladh laistigh de do líonra féin."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:86
msgid ""
"A unique mark is allocated for each CHILD_SA and direction, so Mark In and "
"Mark Out differ."
msgstr ""
"Sanntar marc uathúil do gach CHILD_SA agus do gach treo, sa chaoi is go "
"mbíonn an Marc Isteach agus an Marc Amach difriúil óna chéile."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:84
msgid "A unique mark is allocated for each CHILD_SA."
msgstr "Sanntar marc uathúil do gach CHILD_SA."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:10
msgid "Absolutely silent"
msgstr "Go hiomlán ciúin"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:722
msgid "Action on initial configuration load"
msgstr "Gníomh ar an ualach cumraíochta tosaigh"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:732
msgid "Action when CHILD_SA is closed"
msgstr "Gníomh nuair a bhíonn CHILD_SA dúnta"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:769
msgid "Action when DPD timeout occurs"
msgstr "Gníomh nuair a tharlaíonn teorainn ama DPD"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:293
msgid "Active IKE_SAs"
msgstr "IKE_SAanna gníomhacha"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:220
msgid "Addresses"
msgstr "Seoltaí"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:221
msgid ""
"Addresses that are allocated to the peers from this pool, one address per "
"connected peer."
msgstr ""
"Seoltaí a shanntar do na piaraí ón linn seo, seoladh amháin in aghaidh gach "
"piara atá ceangailte."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:218
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:328
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:672
msgid "Advanced"
msgstr "Ardleibhéil"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:918
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:928
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:939
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:957
msgid "Algorithms marked with * are considered insecure"
msgstr "Meastar go bhfuil halgartaim atá marcáilte le * neamhshábháilte"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:275
msgid "All other traffic of the peer bypasses the tunnel."
msgstr "Seachnaíonn gach trácht eile ón gcomhpháirtí an tollán."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:284
msgid "All other traffic of the peer is sent through the tunnel."
msgstr "Seoltar an trácht eile ar fad ón gcomhpháirtí tríd an tollán."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:15
msgid "Also include sensitive material in dumps, e.g. keys"
msgstr "Cuir ábhar íogair san áireamh i ndumpanna freisin, m.sh. eochracha"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:850
msgid "Also used to derive lifebytes if set (110% of this value)."
msgstr ""
"Úsáidtear é freisin chun bearta saoil a dhíorthú má shocraítear é (110% den "
"luach seo)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:871
msgid "Also used to derive lifepackets if set (110% of this value)."
msgstr ""
"Úsáidtear é freisin chun pacáistí saoil a dhíorthú má shocraítear é (110% "
"den luach seo)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:780
msgid "Also used to derive lifetime (110% of this value)."
msgstr "Úsáidtear é freisin chun saolré a dhíorthú (110% den luach seo)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:174
msgid "An optional description of what this authority is used for."
msgstr "Cur síos roghnach ar an gcuspóir a bhaineann leis an údarás seo."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/secrets.js:106
msgid "An optional description of what this secret is used for."
msgstr "Cur síos roghnach ar an úsáid a bhaintear as an rún seo."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:64
msgid "Applications other than daemons"
msgstr "Feidhmchláir seachas deamhain"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:327
msgid "Authentication"
msgstr "Fíordheimhniú"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:587
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:619
msgid "Authentication Method"
msgstr "Modh Fíordheimhnithe"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:167
msgid "Authority"
msgstr "Údarás"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:181
msgid "Base URI for the Hash and URL feature of IKEv2."
msgstr "Bun-URI do ghné an Hais agus an URL in IKEv2."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:239
msgid ""
"Before migration, the file '/etc/config/ipsec' is moved to '/etc/config/"
"ipsec_bak'."
msgstr ""
"Roimh an aistriú, bogtar an comhad '/etc/config/ipsec' go '/etc/config/"
"ipsec_bak'."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:209
msgid ""
"Besides the addresses, a pool can also carry additional configuration "
"attributes such as DNS servers or split tunneling networks, which are sent "
"to the peer together with the address."
msgstr ""
"Chomh maith leis na seoltaí, is féidir le linn (pool) tréithe cumraíochta "
"breise a iompar freisin — freastalaithe DNS nó líonraí a úsáideann tollánú "
"scoilte (split tunneling), mar shampla — a sheoltar chuig an gcomhpháirtí "
"(peer) mar aon leis an seoladh."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:107
msgid "Bytes in"
msgstr "Bearta isteach"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:108
msgid "Bytes out"
msgstr "Bearta amach"

