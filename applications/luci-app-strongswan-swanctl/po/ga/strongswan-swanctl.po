msgid "CA certificate to use as trust anchor, relative to %s."
msgstr "Deimhniú CA le húsáid mar ancaire iontaoibhe, i gcoibhneas le %s."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:73
