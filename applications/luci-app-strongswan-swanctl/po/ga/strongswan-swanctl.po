msgstr "Logaí iniúchóireachta an-bhunúsacha"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1046
msgid "Virtual IP addresses"
msgstr "Seoltaí IP fíorúla"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1047
msgid "Virtual IP addresses used as the source IP for outgoing traffic."
msgstr ""
"Seoltaí IP fíorúla a úsáidtear mar IP foinseach le haghaidh tráchta amach."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:931
msgid "Warning: The migration will drop all IPsec VPN connections."
msgstr "Rabhadh: Cuirfidh an t-aistriú deireadh le gach nasc IPsec VPN."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1425
msgid "When enabled, you can specify your own proposal string."
msgstr ""
"Nuair a bhíonn sé cumasaithe, is féidir leat do shreangán molta féin a "
"shonrú."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:156
msgid ""
"When this is enabled, the routes for all XFRM interfaces are set "
"automatically."
msgstr ""
"Nuair a bhíonn sé seo cumasaithe, socraítear na bealaí do gach comhéadan "
"XFRM go huathoibríoch."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:233
msgid "Whether the attribute is applied depends on the client."
msgstr ""
"Braitheann sé ar an gcliant cé acu a chuirtear an tréith i bhfeidhm nó nach "
"gcuirtear."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1422
msgid "Whether this is an ESP (phase 2) proposal or not"
msgstr "Cibé acu togra ESP (céim 2) atá ann nó nach ea"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:414
