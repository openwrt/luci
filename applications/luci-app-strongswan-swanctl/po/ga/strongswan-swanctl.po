msgid "CRLs stored in %s are read by swanctl when loading credentials."
msgstr ""
"Léann swanctl na CRLanna atá stóráilte i %s nuair a bhíonn dintiúir á luchtú."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:180
msgid "Certificate Base URI"
msgstr "Bun-URI an Teastais"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:601
msgid "Certificate to use for authentication, relative to %s."
msgstr "Teastas le húsáid le haghaidh fíordheimhnithe, i ndáil le %s."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:115
