#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:330
msgid "Stop"
msgstr "Stop"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:265
msgid "Subnet"
msgstr "Fo-líonra"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:266
msgid ""
"Subnets in CIDR notation that are announced to the peers as protected by the "
"tunnel."
msgstr ""
"Fo-líonraí i nótáil CIDR a fhógraítear do na piaraí mar líonraí atá cosanta "
"ag an tollán."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:283
msgid ""
"Subnets in CIDR notation that the peers must not send through the tunnel."
msgstr ""
"Fo-líonraí i nótáil CIDR nach mór do na piaraí gan iad a sheoladh tríd an "
"tollán."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:274
msgid ""
"Subnets in CIDR notation that the peers send through the tunnel (split "
"tunneling)."
msgstr ""
"Fo-líonraí i nótáil CIDR a sheolann na piaraí tríd an tollán (tollánú "
"scoilte)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:190
msgid "Supported schemes are http, ldap and file."
msgstr "Is iad http, ldap agus file na scéimeanna a dtacaítear leo."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:61
msgid "Syslog Settings"
msgstr "Socruithe Syslog"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:406
msgid "The Children containing the ESP (phase 2) section"
msgstr "Na heilimintí fo-ordaithe ina bhfuil an rannán ESP (céim 2)"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:183
msgid ""
"The certificate URIs are built by appending the SHA1 hash of the DER encoded "
"certificate to this base URI."
msgstr ""
"Cruthaítear na URIanna deimhnithe trí hais SHA1 an deimhnithe, atá "
"ionchódaithe i bhformáid DER, a chur leis an mbun-URI seo."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:82
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/secrets.js:80
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:189
msgid "The file \"%s\" does not exist."
msgstr "Níl an comhad \"%s\" ann."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:114
msgid ""
"The hash is omitted for authenticated encryption (AEAD) algorithms. The PRF "
"is used for IKE proposals only."
msgstr ""
"Fágtar an hais ar lár i gcás algartam criptithe fíordheimhnithe (AEAD). Ní "
"úsáidtear an PRF ach amháin i gcás tograí IKE."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:83
msgid "The mask defaults to 0xffffffff."
msgstr "Is é 0xffffffff an luach réamhshocraithe don masc."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:240
msgid "The migration may require manual intervention."
msgstr "D’fhéadfadh idirghabháil láimhe a bheith ag teastáil ón imirce."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:211
msgid ""
"The name of the section is the name of the pool, under which a connection "
"refers to it."
msgstr ""
"Is é ainm an ailt ná ainm an linn, a ndéanann nasc tagairt dó faoina ainm."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:427
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:458
msgid "The order matters: the sections are used in the order they are listed."
msgstr ""
"Tá tábhacht leis an ord: úsáidtear na rannáin san ord ina bhfuil siad "
"liostaithe."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:231
msgid ""
"The peers use them to resolve names while the tunnel is up, e.g. for hosts "
"in the remote network."
msgstr ""
"Úsáideann na piaraí iad chun ainmneacha a réiteach fad is atá an tollán "
"gníomhach, m.sh. i gcás óstach sa líonra iargúlta."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:911
msgid ""
"The string is used verbatim as the proposal instead of the assembled one."
msgstr ""
"Úsáidtear an teaghrán focal ar fhocal mar an togra, in áit an chinn a "
"cuireadh le chéile."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:241
msgid "Therefore, the VPN is not restarted."
msgstr "Dá bhrí sin, ní dhéantar an VPN a atosú."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:199
msgid "These are usually http URLs."
msgstr "Is URLanna http iad seo de ghnáth."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:556
msgid ""
"This makes the peer believe that a NAT situation exist on the transmission "
"path, forcing it to encapsulate ESP packets in UDP."
msgstr ""
"Fágann sé seo go gcreideann an piaraí go bhfuil cás NAT ann ar an gcosán "
"tarchuir, rud a chuireann iallach air paicéid ESP a ionchopláil in UDP."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:713
msgid ""
"This option must be enabled in the service configuration (Netlink Settings) "
"for routes to be set automatically."
msgstr ""
"Caithfear an rogha seo a chumasú i gcumraíocht na seirbhíse (Socruithe "
"Netlink) chun go socrófar bealaí go huathoibríoch."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:530
msgid "Timeout to close connection if no response to DPD is received."
msgstr "Teorainn ama chun an nasc a dhúnadh mura bhfaightear freagra ar DPD."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:555
msgid ""
"To enforce UDP encapsulation of ESP packets, the IKE daemon can manipulate "
"the NAT detection payloads."
msgstr ""
"Chun ionchorprú UDP ar phaicéid ESP a fhorfheidhmiú, is féidir leis an "
"daemon IKE na hualaí braite NAT a ionramháil."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:677
msgid "Transport"
msgstr "Iompar"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:118
msgid "Trusted Network Connect"
msgstr "Ceangal Líonra Iontaofa"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:676
msgid "Tunnel"
msgstr "Tollán"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/secrets.js:108
msgid "Type"
msgstr "Cineál"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:198
msgid ""
"URIs of OCSP responders that can be queried for the revocation status of "
"certificates issued by this CA."
msgstr ""
"URIanna de fhreagróirí OCSP ar féidir ceist a chur orthu maidir le stádas "
"cúlghairthe deimhnithe arna n-eisiúint ag an Údarás Deimhnithe (CA) seo."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:189
msgid ""
"URIs where a CRL (certificate revocation list) issued by this CA can be "
"fetched."
msgstr ""
"URIanna ar féidir CRL (liosta deimhnithe arna gcúlghairm) arna eisiúint ag "
"an Údarás Deimhnithe (CA) seo a fháil astu."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:85
msgid "Unique ID"
msgstr "Aitheantas Uathúil"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:452
msgid "Unknown Local section"
msgstr "Rannóg áitiúil anaithnid"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:483
msgid "Unknown Remote section"
msgstr "Rannán iargúlta anaithnid"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:763
msgid "Up/Down Script Path"
msgstr "Cosán Scripte Suas/Síos"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:291
msgid "Uptime"
msgstr "Am oibríochta"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:861
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:882
msgid "Use \"0\" to disable (default)."
msgstr "Úsáid \"0\" chun é a dhíchumasú (réamhshocrú)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:851
msgid "Use \"0\" to disable byte based rekeying."
msgstr "Úsáid \"0\" chun ath-eochrú bunaithe ar bheart a dhíchumasú."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:872
msgid "Use \"0\" to disable packet based rekeying (default)."
msgstr ""
"Úsáid \"0\" chun ath-eochrú bunaithe ar phaicéid a dhíchumasú (réamhshocrú)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:509
msgid "Use IKE fragmentation"
msgstr "Úsáid ilroinnt IKE"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:218
msgid "Use combinations like child1_phase1."
msgstr "Bain úsáid as teaglaim ar nós child1_phase1."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:901
msgid "Use custom proposal"
msgstr "Úsáid togra saincheaptha"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:9
msgid "Use daemon default"
msgstr "Bain úsáid as réamhshocrú an deamhain"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:907
msgid "Using this option only if you know exactly what you are doing."
msgstr ""
"Ná húsáid an rogha seo ach amháin má tá a fhios agat go díreach cad atá á "
"dhéanamh agat."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:909
msgid "Using this setting may prevent future updates or migrations."
msgstr ""
"D’fhéadfadh úsáid an tsuímh seo cosc a chur ar nuashonruithe nó ar "
"imirceanna sa todhchaí."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:253
msgid "Usually not required, as most clients derive it on their own."
msgstr ""
"De ghnáth ní bhíonn sé ag teastáil, ós rud é go bhfaigheann formhór na "
"gcliant é dóibh féin."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:260
msgid "Usually not required."
msgstr "De ghnáth níl sé ag teastáil."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:557
msgid ""
"Usually this is not required but it can help to work around connectivity "
"issues with too restrictive intermediary firewalls that block ESP packets."
msgstr ""
"De ghnáth ní bhíonn sé seo riachtanach ach is féidir leis cabhrú le "
"fadhbanna nascachta a sheachaint le ballaí dóiteáin idirmheánacha atá ró-"
"shriantacha a chuireann bac ar phaicéid ESP."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:843
msgid "Values larger than 32 are supported by the Netlink backend only"
msgstr "Ní thacaíonn ach cúltaca Netlink le luachanna níos mó ná 32"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:90
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:290
msgid "Version"
msgstr "Leagan"

