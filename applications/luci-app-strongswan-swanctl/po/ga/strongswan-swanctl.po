#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:77
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/secrets.js:75
msgid "A file must be selected."
msgstr "Caithfear comhad a roghnú."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:925
msgid "A legacy IPsec configuration was found."
msgstr "Aimsíodh cumraíocht IPsec shean-nóis."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:192
msgid "A local file must be given as a file URI, e.g. %s."
msgstr "Ní mór comhad áitiúil a sholáthar mar URI comhaid, m.sh. %s."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:208
msgid ""
"A pool is a named range of virtual IP addresses that the IKE daemon hands "
"out to remote peers (road warriors) when they connect, so that they get an "
"address inside your network."
msgstr ""
"Is éard is \"linn\" ann ná raon ainmnithe de sheoltaí IP fíorúla a shanntar "
"ag an deamhan IKE do chomhpháirtithe cianda (úsáideoirí soghluaiste) nuair a "
"nascann siad, ionas go bhfaigheann siad seoladh laistigh de do líonra féin."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:87
msgid ""
"A unique mark is allocated for each CHILD_SA and direction, so Mark In and "
"Mark Out differ."
msgstr ""
"Sanntar marc uathúil do gach CHILD_SA agus do gach treo, sa chaoi is go "
"mbíonn an Marc Isteach agus an Marc Amach difriúil óna chéile."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:85
msgid "A unique mark is allocated for each CHILD_SA."
msgstr "Sanntar marc uathúil do gach CHILD_SA."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:564
msgid "AAA ID"
msgstr "Aitheantas AAA"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1303
msgid "AF11"
msgstr "AF11"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1304
msgid "AF21"
msgstr "AF21"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1305
msgid "AF31"
msgstr "AF31"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1306
msgid "AF41"
msgstr "AF41"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:122
msgid ""
"Absolute path of the log file below <code>/tmp</code> or <code>/var/log</"
"code>."
msgstr ""
"Conair iomlán an chomhaid loga faoi <code>/tmp</code> nó <code>/var/log</"
"code>."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:11
msgid "Absolutely silent"
msgstr "Go hiomlán ciúin"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:103
msgid ""
"Accept IKEv1 Aggressive Mode with pre-shared keys as responder. This is "
"insecure."
msgstr ""
"Glac le Mód Ionsaitheach IKEv1 le heochracha réamhroinnte mar fhreagróir. "
"Níl sé seo slán."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:315
msgid "Action on initial configuration load"
msgstr "Gníomh ar an ualach cumraíochta tosaigh"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:325
msgid "Action when CHILD_SA is closed"
msgstr "Gníomh nuair a bhíonn CHILD_SA dúnta"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:365
msgid "Action when DPD timeout occurs"
msgstr "Gníomh nuair a tharlaíonn teorainn ama DPD"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:386
msgid "Active IKE_SAs"
msgstr "IKE_SAanna gníomhacha"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:221
msgid "Addresses"
msgstr "Seoltaí"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:222
msgid ""
"Addresses that are allocated to the peers from this pool, one address per "
"connected peer."
msgstr ""
"Seoltaí a shanntar do na piaraí ón linn seo, seoladh amháin in aghaidh gach "
"piara atá ceangailte."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:219
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:265
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1022
msgid "Advanced"
msgstr "Ardleibhéil"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1348
msgid "Aggressive Mode"
msgstr "Mód Ionsaitheach"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1354
msgid ""
"Aggressive Mode with PSK authentication is rejected as responder unless it "
"is allowed in the service configuration (General Settings)."
msgstr ""
"Diúltaítear don Mhód Ionsaitheach le fíordheimhniú PSK mar fhreagróir mura "
"gceadaítear é i gcumraíocht na seirbhíse (Socruithe Ginearálta)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1446
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1456
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1467
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1485
msgid "Algorithms marked with * are considered insecure"
msgstr "Meastar go bhfuil halgartaim atá marcáilte le * neamhshábháilte"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:276
msgid "All other traffic of the peer bypasses the tunnel."
msgstr "Seachnaíonn gach trácht eile ón gcomhpháirtí an tollán."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:285
msgid "All other traffic of the peer is sent through the tunnel."
msgstr "Seoltar an trácht eile ar fad ón gcomhpháirtí tríd an tollán."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:102
msgid "Allow Aggressive Mode with PSK"
msgstr "Ceadaigh an Mód Ionsaitheach le PSK"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:16
msgid "Also include sensitive material in dumps, e.g. keys"
msgstr "Cuir ábhar íogair san áireamh i ndumpanna freisin, m.sh. eochracha"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:462
msgid "Also used to derive lifebytes if set (110% of this value)."
msgstr ""
"Úsáidtear é freisin chun bearta saoil a dhíorthú má shocraítear é (110% den "
"luach seo)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:483
msgid "Also used to derive lifepackets if set (110% of this value)."
msgstr ""
"Úsáidtear é freisin chun pacáistí saoil a dhíorthú má shocraítear é (110% "
"den luach seo)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:382
msgid "Also used to derive lifetime (110% of this value)."
msgstr "Úsáidtear é freisin chun saolré a dhíorthú (110% den luach seo)."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:175
msgid "An optional description of what this authority is used for."
msgstr "Cur síos roghnach ar an gcuspóir a bhaineann leis an údarás seo."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/secrets.js:107
msgid "An optional description of what this secret is used for."
msgstr "Cur síos roghnach ar an úsáid a bhaintear as an rún seo."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:138
msgid "Append"
msgstr "Cuir leis"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:139
msgid ""
"Append to an existing log file instead of truncating it on daemon start."
msgstr ""
"Cuir leis an gcomhad logála atá ann cheana, in áit é a ghiorrú, nuair a "
"thosaíonn an deamhan."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:22
msgid "Applications other than daemons"
msgstr "Feidhmchláir seachas deamhain"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1021
msgid "Authentication"
msgstr "Fíordheimhniú"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:509
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:589
msgid "Authentication Method"
msgstr "Modh Fíordheimhnithe"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:168
msgid "Authority"
msgstr "Údarás"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:182
msgid "Base URI for the Hash and URL feature of IKEv2."
msgstr "Bun-URI do ghné an Hais agus an URL in IKEv2."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:928
msgid ""
"Before migration, the file '/etc/config/ipsec' is moved to '/etc/config/"
"ipsec_bak'."
msgstr ""
"Roimh an aistriú, bogtar an comhad '/etc/config/ipsec' go '/etc/config/"
"ipsec_bak'."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:210
msgid ""
"Besides the addresses, a pool can also carry additional configuration "
"attributes such as DNS servers or split tunneling networks, which are sent "
"to the peer together with the address."
msgstr ""
"Chomh maith leis na seoltaí, is féidir le linn (pool) tréithe cumraíochta "
"breise a iompar freisin — freastalaithe DNS nó líonraí a úsáideann tollánú "
"scoilte (split tunneling), mar shampla — a sheoltar chuig an gcomhpháirtí "
"(peer) mar aon leis an seoladh."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:153
msgid "Bytes in"
msgstr "Bearta isteach"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:154
msgid "Bytes out"
msgstr "Bearta amach"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:177
msgid "CA Certificate"
msgstr "Teastas CA"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:178
msgid "CA certificate to use as trust anchor, relative to %s."
msgstr "Deimhniú CA le húsáid mar ancaire iontaoibhe, i gcoibhneas le %s."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:25
msgid "CHILD_SA/IPsec_SA"
msgstr "CHILD_SA/IPsec_SA"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:189
msgid "CRL URIs"
msgstr "URIanna CRL"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:193
msgid "CRLs stored in %s are read by swanctl when loading credentials."
msgstr ""
"Léann swanctl na CRLanna atá stóráilte i %s nuair a bhíonn dintiúir á luchtú."

