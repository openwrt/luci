#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:394
#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1277
msgid "Use %s to disable randomization."
msgstr "A véletlenszerűsítés letiltásához használja a következőt: %s."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1235
msgid ""
"Use %s to retry until the connection is established or fails with a "
"permanent error."
msgstr ""
"A(z) %s értékkel addig próbálkozik, amíg a kapcsolat létre nem jön, vagy "
"végleges hibával meg nem hiúsul."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1225
msgid "Use IKE fragmentation"
msgstr "IKE-töredékelés használata"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1349
msgid "Use IKEv1 Aggressive Mode instead of IKEv1 Main Mode"
msgstr "IKEv1 Aggressive Mode használata IKEv1 Main Mode helyett"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:652
msgid "Use combinations like child1_phase1."
msgstr "Használjon child1_phase1-hez hasonló kombinációkat."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1424
msgid "Use custom proposal"
msgstr "Egyéni javaslat használata"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:10
msgid "Use daemon default"
msgstr "A szolgáltatás alapértékének használata"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1430
msgid "Using this option only if you know exactly what you are doing."
msgstr "Csak akkor használja ezt a lehetőséget, ha pontosan tudja, mit csinál."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1432
msgid "Using this setting may prevent future updates or migrations."
msgstr ""
"Ennek a beállításnak a használata megakadályozhatja a jövőbeli frissítéseket "
"vagy áttelepítéseket."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:254
msgid "Usually not required, as most clients derive it on their own."
msgstr "Általában nem szükséges, mert a legtöbb kliens maga származtatja."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:261
msgid "Usually not required."
msgstr "Általában nem szükséges."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1285
msgid ""
"Usually this is not required but it can help to work around connectivity "
"issues with too restrictive intermediary firewalls that block ESP packets."
msgstr ""
"Általában nem szükséges, de segíthet a kapcsolódási problémák "
"megkerülésében, ha egy túl szigorú köztes tűzfal blokkolja az ESP-csomagokat."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:455
msgid "Values larger than 32 are supported by the Netlink backend only"
msgstr "A 32-nél nagyobb értékeket csak a Netlink háttérrendszer támogatja"

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/status.js:134
