msgid "CA certificate to use as trust anchor, relative to %s."
msgstr ""
"Bizalmi horgonyként használandó CA-tanúsítvány, a(z) %s könyvtárhoz "
"viszonyítva."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/strongswan.js:25
msgid "CHILD_SA/IPsec_SA"
