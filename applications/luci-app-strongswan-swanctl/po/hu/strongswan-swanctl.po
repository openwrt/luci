msgstr ""
"Engedélyezve az összes XFRM-interfész útvonalait automatikusan beállítja."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/general.js:233
msgid "Whether the attribute is applied depends on the client."
msgstr "Az attribútum alkalmazása a klienstől függ."

#: applications/luci-app-strongswan-swanctl/htdocs/luci-static/resources/view/strongswan-swanctl/swanctl.js:1422
msgid "Whether this is an ESP (phase 2) proposal or not"
msgstr "ESP (2. fázis) javaslat-e vagy sem"

