#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:706
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1209
msgid "0 No active transition"
msgstr "0 Brak aktywnego przejścia"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1118
msgid "0 means never discard"
msgstr "Wartość 0 oznacza nigdy nie usuwaj"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:707
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1210
msgid "1 Passive BSS-transition-request"
msgstr "1 Pasywne żądanie przejścia BSS"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:708
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1211
msgid "2 BSS-transition-request with disassociation imminent"
msgstr "2 Żądanie przejścia BSS z nieuchronnym rozłączeniem"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:709
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1212
msgid "3 BSS-transition-request with disassociation imminent and timer"
msgstr "3 Żądanie przejścia BSS z nieuchronnym rozłączeniem i minutnikiem"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:710
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1213
msgid ""
"4 BSS-transition-request with disassociation imminent, timer and forced "
"disassociation"
msgstr ""
"4 Żądanie przejścia BSS z nieuchronnym rozłączeniem, minutnikiem i "
"wymuszonym rozłączeniem"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:183
msgid ""
"A signal of 0 is a cold-start placeholder, not a real reading: it marks a "
"node as \"worth exploring\" for a station connected elsewhere, so the "
"station gets pushed there once to find out for real."
msgstr ""
"Sygnał 0 to placeholder startowy, nie rzeczywisty odczyt: oznacza węzeł jako "
"„wart sprawdzenia” dla urządzenia połączonego gdzie indziej, więc urządzenie "
"zostanie tam raz przekierowane, aby poznać rzeczywistą wartość."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:815
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1309
msgid "A value of 0 disables threshold."
msgstr "Wartość 0 wyłącza próg."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:78
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:189
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:378
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:399
msgctxt "Name or IP address of access point"
msgid "AP"
msgstr "AP"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:235
msgid "AP PeerKey"
msgstr "Klucz peera AP"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:195
msgid "Age (s)"
msgstr "Wiek (s)"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:703
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1206
msgid "Aggressiveness"
msgstr "Agresywność"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:723
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1219
msgid "Aggressiveness mac list"
msgstr "Lista adresów MAC agresywności"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:704
msgid ""
"Aggressiveness of BSS-transition-request to push a station connected to this "
"SSID to another node, default 3"
msgstr ""
"Agresywność żądania przejścia BSS w celu wypchnięcia urządzenia połączonego "
"z tym SSID do innego SSID, domyślnie 3"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1207
msgid ""
"Aggressiveness of BSS-transition-request to push a station to another node "
"(AP or band)."
msgstr ""
"Agresywność żądania przejścia BSS w celu wypchnięcia stacji do innego węzła "
"(punktu dostępu lub pasma)."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1063
msgid "All debug messages"
msgstr "Wszystkie komunikaty debugowania"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1187
msgid "Allow ignoring probe requests for steering purposes"
msgstr "Zezwalaj na ignorowanie żądań sondowania do celów sterowania"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:684
msgid ""
"Allow ignoring probe requests for steering purposes, for stations on this "
"SSID"
msgstr ""
"Zezwalaj na ignorowanie żądań sondowania do celów sterowania, dla urządzeń "
"na tym SSID"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1184
msgid "Allow rejecting assoc requests for steering purposes"
msgstr "Zezwalaj na odrzucanie żądań podłączania do celów sterowania"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:678
msgid ""
"Allow rejecting assoc requests for steering purposes, for stations on this "
"SSID"
msgstr ""
"Zezwalaj na odrzucanie żądań podłączania do celów sterowania, dla urządzeń "
"na tym SSID"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:423
msgid "Also be sure to enable rrm reports, 80211kv, etc."
msgstr "Pamiętaj o włączeniu raportów rrm, 80211kv itp."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:966
msgid "An incorrect parameter can cause usteer to fail to start up."
msgstr "Nieprawidłowy parametr może spowodować, że usteer się nie uruchomi."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:678
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1184
msgid "Assoc steering"
msgstr "Sterowanie podłączaniem"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:801
msgid ""
"Attempting to steer clients on this SSID to a higher frequency-band every n "
"ms. A value of 0 disables band-steering."
msgstr ""
"Czas w (ms) między próbami przekierowania urządzeń tego SSID na wyższe pasmo "
"częstotliwości. Wartość 0 wyłącza sterowanie pasmem."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1295
msgid ""
"Attempting to steer clients to a higher frequency-band every n ms. A value "
"of 0 disables band-steering."
msgstr ""
"Próba skierowania klientów na wyższe pasmo częstotliwości co n ms. Wartość 0 "
"wyłącza sterowanie pasmem."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:814
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1308
msgid "Avoids conflicts between roaming and band-steering policies."
msgstr ""
"Pozwala uniknąć konfliktów pomiędzy zasadami roamingu i sterowania pasmem."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:380
msgid "BSSID"
msgstr "BSSID"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:801
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1295
msgid "Band steering interval"
msgstr "Interwał sterowania pasmem"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:805
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1300
msgid "Band steering min SNR"
msgstr "Minimalny SNR sterowania pasmem"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:812
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1306
msgid "Band steering signal threshold"
msgstr "Próg sygnału sterowania pasmem"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:694
#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:1195
msgid "Band steering threshold"
msgstr "Próg sterowania pasmem"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:182
msgid ""
"Best signal ever locally observed per node for a station, kept as a roaming "
"fallback for stations that never probe or report RRM measurements once "
"associated (many home-appliance/IoT WiFi stacks never do)."
msgstr ""
"Najlepszy sygnał kiedykolwiek zaobserwowany lokalnie dla urządzenia na danym "
"węźle, przechowywany jako rezerwowa metoda roamingu dla urządzeń, które "
"nigdy nie wysyłają probe ani raportów RRM po połączeniu (wiele stosów WiFi w "
"sprzęcie domowym/IoT tego nie robi)."

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:374
msgid "Client list"
msgstr "Lista klientów"

#: applications/luci-app-usteer/htdocs/luci-static/resources/view/usteer/usteer.js:749
msgid "Connect threshold"
msgstr "Minimalny poziom sygnału przyłączenia"

