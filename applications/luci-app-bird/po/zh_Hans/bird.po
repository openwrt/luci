msgid "A passive interface advertises its subnet without forming neighbors. On an active link, area, timers and authentication must match the peer."
msgstr "被动接口通告本网段，但不建立邻居。主动接口的区域、计时器和认证设置须与对端一致。"

msgid "Actions"
msgstr "操作"

msgid "Add area"
msgstr "添加区域"

msgid "Add interface"
msgstr "添加接口"

msgid "Advanced Settings"
msgstr "高级设置"

msgid "Always translate NSSA external LSAs"
msgstr "强制转换 NSSA 外部 LSA"

msgid "Area 0 must be normal. Enter summary prefixes separated by spaces. An area takes effect when assigned to an interface."
msgstr "区域 0 必须为普通区域。汇总前缀用空格分隔。将区域分配给接口后生效。"

msgid "Area ID"
msgstr "区域 ID"

msgid "Area type"
msgstr "区域类型"

msgid "Area types and summaries"
msgstr "区域类型和汇总"

msgid "Area"
msgstr "区域"

msgid "Authentication"
msgstr "认证"

msgid "Plaintext password (OSPFv2 only)"
msgstr "明文密码（仅 OSPFv2）"

msgid "No OSPF authentication"
msgstr "未启用 OSPF 认证"

msgid "Add authentication key"
msgstr "添加认证密钥"

msgid "Key rotation schedule"
msgstr "密钥轮换时间"

msgid "Remove authentication keys before setting the interface to passive."
msgstr "请先删除认证密钥，再将接口设为被动模式。"

msgid "An authentication key uses an address family not enabled on this interface."
msgstr "认证密钥使用了此接口未启用的地址族。"

msgid "Simple authentication requires one OSPFv2 password of at most eight characters and no key timing."
msgstr "明文认证只支持一个不超过八个字符的 OSPFv2 密码，且不能设置轮换时间。"

msgid "Send only"
msgstr "仅发送"

msgid "Dead multiplier (blank uses the interval in seconds)"
msgstr "失效间隔倍数（留空时使用秒数）"

msgid "Neighbors eligible for DR election"
msgstr "具备 DR 选举资格的邻居"

msgid "Other manual neighbors"
msgstr "其他手动邻居"

msgid "Do not install unmatched routes"
msgstr "不安装未匹配规则的路由"

msgid "Route policy and filters"
msgstr "路由策略和过滤规则"

msgid "Exact-prefix rules apply first. The default policy applies only when no rule matches."
msgstr "精确前缀规则优先匹配。只有未命中任何规则时才应用默认策略。"

msgid "Default IPv4 route installation policy"
msgstr "默认 IPv4 路由安装策略"

msgid "Install IPv6 OSPF routes by default"
msgstr "默认安装 IPv6 OSPF 路由"

msgid "Default IPv4 redistribution prefixes"
msgstr "默认 IPv4 重分发前缀"

msgid "Default IPv6 redistribution prefixes"
msgstr "默认 IPv6 重分发前缀"

msgid "Area settings do not apply to the selected area type."
msgstr "这些区域参数不适用于所选的区域类型。"

msgid "RFC 1583 compatibility requires OSPFv2 for IPv4."
msgstr "RFC 1583 兼容模式要求 IPv4 使用 OSPFv2。"

msgid "Choose either an E1 or an E2 default metric for NSSA default origination."
msgstr "NSSA 默认路由通告只能选择 E1 或 E2 开销中的一种。"

msgid "Multiple route rules match the same family, direction and prefix."
msgstr "存在多条匹配同一地址族、方向和前缀的路由规则。"

msgid "Route metrics and tags require an accepted redistribution rule."
msgstr "只有接受重分发的规则才能配置开销和路由标签。"

msgid "Choose either an E1 or an E2 metric for a route rule."
msgstr "路由规则只能选择 E1 或 E2 开销中的一种。"

msgid "BFD uses one authentication mode per interface and one password in simple mode."
msgstr "每个接口只能使用一种 BFD 认证模式。明文模式只支持一个密码。"

msgid "An area prefix cannot be both advertised as a summary and hidden."
msgstr "同一区域前缀不能同时作为汇总路由通告和隐藏。"

msgid "A hidden NSSA external summary cannot have a route tag."
msgstr "隐藏的 NSSA 外部汇总前缀不能设置路由标签。"

msgid "Set the area type to NSSA before adding an external summary."
msgstr "添加外部汇总前，请将区域类型设为 NSSA。"

msgid "A manual neighbor can only be listed once for each address family and interface."
msgstr "每个接口和地址族下，手动邻居只能配置一次。"

msgid "The IPv4 channel can only use RFC 5838 when running OSPFv3 with RFC 5838 enabled."
msgstr "IPv4 仅在使用 OSPFv3 并启用 RFC 5838 时才能使用此选项。"

msgid "An additional OSPF instance must use a different ID from the primary interface instance."
msgstr "附加 OSPF 实例的 ID 必须与接口主实例不同。"

msgid "The dead interval multiplier must be greater than one."
msgstr "失效间隔倍数必须大于一。"

msgid "Enter the OSPF receive buffer size."
msgstr "请输入 OSPF 接收缓冲区字节数。"

msgid "Enter a metric for the selected route metric type."
msgstr "请输入所选开销类型的数值。"

msgid "BFD authentication keys must match the selected interface mode."
msgstr "BFD 密钥数量必须与接口认证模式匹配。"

msgid "Invalid dead interval or multiplier on %s."
msgstr "接口 %s 的失效间隔或倍数无效。"

msgid "Select a valid BFD authentication mode."
msgstr "请选择有效的 BFD 认证模式。"

