#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:316
msgid ""
"Policy based routing by mac, source, destination and domain. For further "
"information please check the %s."
msgstr ""
"Směrování založené na zásadách podle mac adresy, zdroje, cíle a domény. "
"Ohledně dalších informací se podívejte do %s."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:422
msgid "Poll"
msgstr "Dotazovat"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:463
msgid "Poll Interval"
msgstr "Interval dotazování"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:494
msgid "Probe Targets"
msgstr "Cíle sondy"

#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:47
