#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:396
msgid "%d name(s) every %ds"
msgstr "%d nazwa(-y) co %ds"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:198
msgid ""
"%d of %d observed responses were not used. That is normal: the observer sees "
"every answer on the network, and only the ones for a domain you routed are "
"of any interest."
msgstr ""
"%d z %d zaobserwowanych odpowiedzi nie zostało wykorzystanych. Jest to "
"normalne zjawisko: obserwator widzi każdą odpowiedź w sieci, a istotne są "
"tylko te, które dotyczą domeny objętej Twoim trasowaniem."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:86
msgid "%d pkt matched"
msgstr "%d pkt dopasowano"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:28
msgid "%dh %dm"
msgstr "%dh %dm"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:32
