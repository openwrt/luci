msgstr "Brak jeszcze dzienników powiązanych z %s!"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:180
msgid "No client is selected, so every client is covered."
msgstr "Nie wybrano żadnego klienta, więc wszystkie klienty są objęte zakresem."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:63
