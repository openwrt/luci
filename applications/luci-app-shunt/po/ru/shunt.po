msgstr "остановлен"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:397
msgid "unavailable - ucode-mod-resolv missing"
msgstr "недоступно — отсутствует ucode-mod-resolv"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:423
msgid "wildcards are covered by the observer only"
msgstr "wildard-адреса обрабатываются только наблюдателем"
