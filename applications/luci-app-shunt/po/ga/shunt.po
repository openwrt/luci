msgid "Domains"
msgstr "Fearainn"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:452
msgid "Enable the shunt service."
msgstr "Cumasaigh an tseirbhís sheunta."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:451
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:111
msgid "Enabled"
msgstr "Cumasaithe"

