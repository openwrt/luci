msgstr "Freagraí DNS a breathnaíodh ar %s ó thosaigh an tseirbhís"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:455
msgid "Debug Logging"
msgstr "Logáil Dífhabhtaithe"

