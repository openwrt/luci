msgstr "Művelet"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:62
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:48
msgid "Action failed: %s"
msgstr "Művelet sikertelen: %s"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:107
msgid "Add policy"
msgstr "Házirend hozzáadása"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:179
msgid "Address"
msgstr "Cím"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:300
msgid "Address begins with …"
msgstr "A cím eleje…"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:524
msgid ""
"Addresses that answer ICMP echo, reachable through every policy interface - "
"public resolvers are the usual choice. Every interface a route policy uses "
"is probed through itself every 5 seconds; one that answers no target for "
"three rounds is treated as down and its policies fall back until it answers "
"again. Empty means no tracking, see the README."
msgstr ""
"ICMP echo-kérésre válaszoló címek, amelyek minden házirend-interfészen át "
"elérhetők — általában nyilvános DNS-feloldók. Minden, útvonal-házirendben "
"használt interfész saját magán keresztül 5 másodpercenként próbát küld; "
"amelyik három körön át egyetlen célra sem kap választ, azt kiesettnek "
"tekinti, és a házirendjei a tartalék viselkedésre váltanak, amíg újra nem "
"válaszol. Üresen nincs követés, lásd a README fájlt."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:141
msgid "Answer carried no usable address"
msgstr "A válasz nem tartalmazott használható címet"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:204
msgid "Answers used for a policy"
msgstr "Házirendhez felhasznált válaszok"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:56
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:42
msgid "Apply failed: %s"
msgstr "Alkalmazás sikertelen: %s"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:164
msgid "Block the traffic (killswitch)"
msgstr "A forgalom blokkolása (killswitch)"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:131
msgid "Bypass - leave the traffic alone"
msgstr "Megkerülés - a forgalom érintetlenül hagyása"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:182
msgid "Bytes routed"
msgstr "Irányított bájtok"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:493
msgid ""
"Ceiling in seconds for a learned address in its Set. An address learned from "
"a DNS answer expires with the TTL of that answer, clamped to the range 60 to "
"this value; a polled address uses this value. Keep it well above the poll "
"interval."
msgstr ""
"Egy tanult cím készletben töltött idejének felső korlátja másodpercben. A "
"DNS-válaszból tanult cím a válasz TTL-jével jár le, 60 és ezen érték közé "
"szorítva; a lekérdezett cím ezt az értéket használja. Tartsa jóval a "
"lekérdezési időköz felett."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:183
msgid "Client MACs this policy applies to, ORed with the addresses above."
msgstr ""
"A kliensek azon MAC-címei, amelyekre a házirend vonatkozik, a fenti címekkel "
"VAGY kapcsolatban."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:226
msgid "Client Selectors"
msgstr "Klienskiválasztók"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:178
msgid ""
"Client addresses or prefixes this policy applies to. Leave empty to apply to "
"every client."
msgstr ""
"Azok a klienscímek vagy előtagok, amelyekre a házirend vonatkozik. Hagyja "
"üresen, ha minden kliensre vonatkozzon."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:149
msgid "Compression pointer in the question"
msgstr "Tömörítési mutató a kérdésben"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:472
msgid "DNS Observer Settings"
msgstr "DNS-megfigyelő beállításai"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:199
msgid "DNS responses observed on %s since the service started"
msgstr "A szolgáltatás indítása óta a(z) %s eszközön megfigyelt DNS-válaszok"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:479
msgid "Debug Logging"
msgstr "Hibakeresési naplózás"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:210
msgid "Destination Address Files"
msgstr "Célcímfájlok"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:205
msgid "Destination Addresses"
msgstr "Célcímek"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:200
msgid "Destination Ports"
msgstr "Célportok"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:206
msgid "Destination addresses or prefixes to route into this policy."
msgstr "A házirendbe irányítandó célcímek vagy előtagok."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:222
msgid "Domain Files"
msgstr "Tartományfájlok"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:139
msgid "Domain is in no policy"
msgstr "A tartomány egyik házirendben sem szerepel"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:217
msgid "Domains"
msgstr "Tartományok"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:476
msgid "Enable the shunt service."
msgstr "A shunt-szolgáltatás engedélyezése."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:475
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:122
msgid "Enabled"
msgstr "Engedélyezve"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:143
msgid "Error reply, e.g. NXDOMAIN"
msgstr "Hibaválasz, például NXDOMAIN"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:100
msgid ""
"Evaluated top to bottom - the first policy a packet matches wins. Within one "
"policy the selectors are ANDed: source plus domain means only that client, "
"and only to those domains."
msgstr ""
"Felülről lefelé értékelődik ki: a csomagra elsőként illeszkedő házirend "
"érvényesül. Egy házirenden belül a kiválasztók ÉS kapcsolatban vannak: a "
"forrás és a tartomány együtt csak az adott klienst és csak az adott "
"tartományokat jelenti."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:188
msgid ""
"Everything arriving on these devices, ORed with the client selectors above - "
"a whole guest network or VLAN, in IPv4 and IPv6 alike, whatever prefix it "
"gets. Not the router's own traffic. For domains, add the device to the "
"observed devices as well."
msgstr ""
"Minden, ami ezeken az eszközökön érkezik, a fenti klienskiválasztókkal VAGY "
"kapcsolatban — egy teljes vendéghálózat vagy VLAN, IPv4-en és IPv6-on "
"egyaránt, bármilyen előtagot is kap. A router saját forgalma nem tartozik "
"ide. Tartományokhoz adja hozzá az eszközt a megfigyelt eszközökhöz is."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:64
msgid "Expecting a bare file name or an absolute path, without whitespace"
msgstr "Puszta fájlnév vagy abszolút elérési út várható, szóköz nélkül"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:180
msgid "Expires"
msgstr "Lejárat"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:161
msgid "Extension header chain too long"
msgstr "A bővítményfejléc-lánc túl hosszú"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:163
msgid "Fall through to the normal uplink"
msgstr "Továbbengedés a normál kimenő kapcsolatra"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:263
msgid "Fallback"
msgstr "Visszaesés"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:160
msgid "Fallback Behavior"
msgstr "Tartalék viselkedés"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:211
msgid ""
"Files with one address or prefix per line, IPv4 and IPv6 mixed, for large "
"published ranges. A bare name lives under /tmp/shunt, an absolute path is "
"used as given. After the file changed, refresh below."
msgstr ""
"Fájlok, soronként egy címmel vagy előtaggal, vegyesen IPv4 és IPv6, nagy "
"közzétett tartományokhoz. A puszta név a /tmp/shunt alatt található, az "
"abszolút elérési út változatlanul használatos. A fájl módosítása után "
"frissítsen lent."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:223
msgid ""
"Files with one domain pattern per line, for large or community-maintained "
"lists. A bare name lives under /tmp/shunt, an absolute path is used as "
"given. Entries from a file are learned by the DNS observer only, never "
"polled; after the file changed, refresh below."
msgstr ""
"Fájlok, soronként egy tartománymintával, nagy vagy közösségi listákhoz. A "
"puszta név a /tmp/shunt alatt található, az abszolút elérési út "
"változatlanul használatos. A fájl bejegyzéseit csak a DNS-megfigyelő tanulja "
"meg, lekérdezés nem történik; a fájl módosítása után frissítsen lent."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:156
msgid "Frame ends mid-structure"
msgstr "A keret egy struktúra közepén ér véget"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:471
msgid "General Settings"
msgstr "Általános beállítások"

#: applications/luci-app-shunt/root/usr/share/rpcd/acl.d/luci-app-shunt.json:3
msgid "Grant access to LuCI app shunt"
msgstr "Hozzáférés engedélyezése a shunt LuCI-alkalmazáshoz"

