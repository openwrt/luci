msgstr "leállítva"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:421
msgid "unavailable - ucode-mod-resolv missing"
msgstr "nem érhető el - hiányzik az ucode-mod-resolv"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:447
