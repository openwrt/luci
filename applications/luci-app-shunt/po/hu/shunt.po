msgstr "Következetlen UDP-hossz"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:258
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:136
msgid "Interface"
msgstr "Interfész"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:169
msgid "Keep Local Traffic"
msgstr "Helyi forgalom megtartása"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:507
msgid "Learned Address Limit"
msgstr "Tanult címek korlátja"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:443
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:171
msgid "Learned addresses"
msgstr "Tanult címek"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:198
msgid "Learned addresses (%d of %d shown)"
msgstr "Tanult címek (%d / %d látható)"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:199
msgid "Learned addresses (%d)"
msgstr "Tanult címek (%d)"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:480
msgid ""
"Log every observed DNS answer and every set write. Useful for a bug report, "
"noisy in normal operation - on a router running adblock roughly half of all "
"answers are error replies, and each one gets a line."
msgstr ""
"Minden megfigyelt DNS-válasz és készletírás naplózása. Hibajelentéshez "
"hasznos, normál működésben zajos — egy adblockot futtató routeren a válaszok "
"nagyjából fele hibaválasz, és mindegyik külön sort kap."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:483
msgid "Manage rp_filter"
msgstr "rp_filter kezelése"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:259
msgid "Mark"
msgstr "Jelölés"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:492
msgid "Maximum Entry Lifetime"
msgstr "Bejegyzés legnagyobb élettartama"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:147
msgid "Message ends mid-structure"
msgstr "Az üzenet egy struktúra közepén ér véget"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:148
msgid "Message too long"
msgstr "Az üzenet túl hosszú"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:508
msgid ""
"Most addresses one learned Set holds, per policy and address family. An "
"address beyond it is not learned until older ones expire and takes the "
"normal uplink meanwhile. It bounds what a host on an observed segment can do "
"with forged DNS answers; raise it only if a policy with a very large list "
"reaches it."
msgstr ""
"Egy tanult készlet házirendenként és címcsaládonként legfeljebb ennyi címet "
"tárolhat. Az ezen felüli cím csak a régebbiek lejárta után tanulódik meg, "
"addig a normál kimenő kapcsolatot használja. Ez korlátozza, mit tehet egy "
"gép a megfigyelt szegmensen hamisított DNS-válaszokkal; csak akkor növelje, "
"ha egy nagyon nagy listájú házirend eléri."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:152
msgid "Name has a byte outside a-z 0-9 - _"
msgstr "A név a-z 0-9 - _ tartományon kívüli bájtot tartalmaz"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:151
msgid "Name too long"
msgstr "A név túl hosszú"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:157
msgid "Neither IPv4 nor IPv6"
msgstr "Sem IPv4, sem IPv6"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/logtemplate.js:33
msgid "No %s related logs yet!"
msgstr "Még nincsenek naplóbejegyzések ehhez: %s!"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:227
msgid "No client is selected, so every client is covered."
msgstr "Nincs kiválasztott kliens, így minden kliensre vonatkozik."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:74
msgid "No output"
msgstr "Nincs kimenet"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:251
msgid "No policy is active."
msgstr "Nincs aktív házirend."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:325
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:93
msgid "No shunt config found!"
msgstr "Nem található shunt-beállítás!"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:162
msgid "Not UDP"
msgstr "Nem UDP"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:144
msgid "Not a response"
msgstr "Nem válasz"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:140
msgid "Not an address query"
msgstr "Nem címlekérdezés"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:146
msgid "Not exactly one question"
msgstr "Nem pontosan egy kérdés"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:172
msgid ""
"Nothing learned yet. The service fills these from its poll cycle and from "
"observed DNS answers."
msgstr ""
"Még nincs tanult adat. A szolgáltatás a lekérdezési ciklusából és a "
"megfigyelt DNS-válaszokból tölti fel ezeket."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:517
msgid "Observed Devices"
msgstr "Megfigyelt eszközök"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:230
msgid ""
"Only needed when the gateway discovered from netifd is wrong, and only for a "
"policy with a single interface. Point to point interfaces need no gateway at "
"all."
msgstr ""
"Csak akkor szükséges, ha a netifd által felderített átjáró hibás, és csak "
"egyetlen interfészt használó házirendnél. A pont-pont interfészeknek "
"egyáltalán nincs szükségük átjáróra."

#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:23
msgid "Overview"
msgstr "Áttekintés"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:181
msgid "Packets routed"
msgstr "Irányított csomagok"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:512
msgid "Passive DNS Observer"
msgstr "Passzív DNS-megfigyelő"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:99
#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:31
msgid "Policies"
msgstr "Házirendek"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:256
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:178
msgid "Policy"
msgstr "Házirend"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:332
msgid ""
"Policy based routing by mac, source, destination and domain. For further "
"information please check the %s."
msgstr ""
"Házirend-alapú útválasztás mac-cím, forrás, cél és tartomány szerint. "
"További információ itt: %s."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:446
msgid "Poll"
msgstr "Lekérdezés"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:487
msgid "Poll Interval"
msgstr "Lekérdezési időköz"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:523
msgid "Probe Targets"
msgstr "Próbacélok"

