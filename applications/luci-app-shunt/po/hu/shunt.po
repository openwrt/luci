msgid "no answer from the backend"
msgstr "nincs válasz a háttérrendszertől"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:231
msgid "no answer to the health probes since %s"
msgstr "%s óta nincs válasz az állapotpróbákra"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:333
msgid "online documentation"
msgstr "online dokumentáció"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:449
