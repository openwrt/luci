#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:420
msgid "%d name(s) every %ds"
msgstr "%d név, %d másodpercenként"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:209
msgid ""
"%d of %d observed responses were not used. That is normal: the observer sees "
"every answer on the network, and only the ones for a domain you routed are "
"of any interest."
msgstr ""
"%d / %d megfigyelt válasz nem lett felhasználva. Ez normális: a megfigyelő a "
"hálózat minden válaszát látja, és csak az Ön által irányított tartományokra "
"vonatkozók érdekesek."

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:48
msgid "%d of %d shown"
msgstr "%d / %d látható"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:101
msgid "%d pkt matched"
msgstr "%d csomag illeszkedett"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:28
