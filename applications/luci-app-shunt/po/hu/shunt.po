msgstr "fut, a házirend alkalmazva"

#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:3
msgid "shunt"
msgstr "shunt"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:132
