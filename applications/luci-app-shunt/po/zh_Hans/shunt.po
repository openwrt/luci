msgstr "无策略活跃。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:309
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:82
msgid "No shunt config found!"
msgstr "未找到 shunt 配置！"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:151
msgid "Not UDP"
msgstr "非 UDP"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:133
msgid "Not a response"
msgstr "非响应"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:129
msgid "Not an address query"
msgstr "非地址查询"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:135
msgid "Not exactly one question"
msgstr "根本不是个问题"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:128
msgid ""
"Nothing learned yet. The service fills these from its poll cycle and from "
"observed DNS answers."
msgstr "还没学到东西。服务从其轮询周期和观测到的 DNS 应答来填充这些。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:488
msgid "Observed Devices"
msgstr "观测到的设备"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:214
msgid ""
"Only needed when the gateway discovered from netifd is wrong. Point to point "
"interfaces need no gateway at all."
msgstr "仅在从 netifd 发现的网关错误时才需要。点到点接口根本不需要网关。"

#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:23
msgid "Overview"
msgstr "概览"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:137
msgid "Packets routed"
msgstr "已路由的数据包"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:483
