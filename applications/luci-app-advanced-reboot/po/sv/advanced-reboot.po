msgstr "Det gick inte att hämta firmwaremiljövariabeln: %s."

#: applications/luci-app-advanced-reboot/htdocs/luci-static/resources/view/system/advanced-reboot.js:70
msgid "Unable to run device helper: %s for partition: %s."
msgstr "Det gick inte att köra enhetshjälparen %s för partitionen %s."

#: applications/luci-app-advanced-reboot/htdocs/luci-static/resources/view/system/advanced-reboot.js:66
msgid "Unable to save environment changes."
msgstr "Det gick inte att spara ändringarna i miljön."

#: applications/luci-app-advanced-reboot/htdocs/luci-static/resources/view/system/advanced-reboot.js:32
msgid "Unable to set Dual Boot Flag Partition entry for partition: %s."
msgstr ""
"Det gick inte att ange posten för dubbelstartsflaggan för partitionen: %s."

#: applications/luci-app-advanced-reboot/htdocs/luci-static/resources/view/system/advanced-reboot.js:41
