msgstr[1] "%d sekce"
msgstr[2] "%d sekcí"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:682
msgid "%s (current)"
msgstr "%s (stávající)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:700
msgid "%s (from bandwidth)"
msgstr "%s (z šířky pásma)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2085
msgid ""
"%s and %s are replaced with the templates shipped by the qosify package, and "
"shaping is left disabled."
msgstr ""
"%s a %s jsou nahrazeny šablonami dodávanými s balíčkem qosify a omezování "
"rychlosti je ponecháno vypnuté."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1809
msgid ""
"%s came back empty although it is %d bytes on disk — refusing to overwrite it"
msgstr ""
"%s přišlo nazpět prázdné i když na disku má %d bajtů – odmítá se ho přepsat"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2346
msgid "%s changed on disk — your unsaved edits are still in the editor."
msgstr ""
"%s změněno na disku – vámi provedené neuložené úpravy se ale pořád ještě "
"nacházejí v editoru."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2249
msgid ""
"%s could not be read — the editor is left empty and will not be saved over "
"it."
msgstr ""
"%s nebylo možné číst – editor je ponechán prázdný a nebude uložen přes něj."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1833
msgid ""
"%s has changed since this editor was loaded. Saving now discards those "
"changes."
msgstr ""
"%s má změny od okamžiku, kdy byl tento editor načten. Uložení nyní tamty "
"změny zahodí."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1864
msgid ""
"%s is %d bytes on disk but was never loaded into the editor — refusing to "
"truncate it. Reload the page first."
msgstr ""
"%s má na disku %d bajtů, ale nikdy nebylo načteno do editoru – odmítá se "
"provést zkrácení. Nejprve stránku znovu načtěte."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:364
msgid "%s is a list in this section — edit %s directly"
msgstr "%s je seznam v této sekci – upravte %s přímo"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1656
msgid ""
"%s is not in the defaults list — qosify does not load it, so the Rules tab "
"has no effect"
msgstr ""
"%s není na seznamu výchozích – qosify ho nenačte, takže záložka Pravidla "
"nemá žádný efekt"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:286
msgid ""
"%s is set to \"%s\" — qosify converts it with atoi(), so anything but a non-"
"zero number means off"
msgstr ""
"%s je nastavené na „%s“ – qosify ho převede pomocí atoi(), takže cokoli "
"kromě nenulového čísla znamená vypnuto"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:750
msgid "%s quick settings"
msgstr "%s rychlá nastavení"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2069
msgid "%s uploaded, qosify reloaded."
msgstr "%s nahráno – qosify znovunačteno."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2103
msgid "%s was not written: %s"
msgstr "%s nebylo zapsáno: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2106
msgid "%s was reset but %s was not written: %s"
msgstr "%s bylo resetováno, ale %s nebylo zapsáno: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1945
msgid "%s, applied (QoS disabled)."
msgstr "%s, uplatněno (QoS zakázáno)."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1950
msgid ""
"%s, applied — qosify did not answer on ubus, so shaping could not be checked."
msgstr ""
"%s, uplatněno – qosify neodpovědělo na ubus, takže omezování provozu nebylo "
"možné zkontrolovat."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1947
msgid "%s, applied."
msgstr "%s, uplatněno."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:459
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:468
msgid "%s: %s \"%s\" is not a class, codepoint or 0-63 — qosify ignores it"
msgstr "%s: %s „%s“ není třída, kódový bod nebo 0-63 – qosify ho ignoruje"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:456
msgid ""
"%s: %s \"%s\" is not a class, codepoint or 0-63 — qosify rejects the whole "
"config and interface changes are not applied"
msgstr ""
"%s: %s „%s“ není třída, kódový bod nebo 0-63 – qosify odmítne celé nastavení "
"a změny pro rozhraní nejsou uplatněny"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:465
msgid ""
"%s: %s \"%s\" is not a codepoint or 0-63 — qosify drops this class and the "
"rules using it"
msgstr ""
"%s: %s „%s“ není kódový bod nebo 0-63 – qosify zahodí tuto třídu a pravidla, "
"které ji používají"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:448
msgid ""
"%s: %s cannot be checked — write it as one plain or fully quoted value, with "
"no backslash"
msgstr ""
"%s: „%s“ nebylo možné zkontrolovat – zapište to jako jednu holou nebo plně "
"citovanou hodnotu, bez jakýchkoli zpětných lomítek"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:451
msgid ""
"%s: %s contains shell metacharacters — qosify runs the tc command with sh -c "
"as root, so they would break it or be executed"
msgstr ""
"%s: %s obsahuje metaznaky shellu – qosify spustí příkaz tc s sh - c jako "
"root, takže by to rozbili nebo budou vykonány"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1109
msgid "(alias)"
msgstr "(alternativní název)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:435
