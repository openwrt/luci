#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1419
msgid "Check Devices"
msgstr "Eszközök ellenőrzése"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1393
msgid "Choose file…"
msgstr "Fájl kiválasztása…"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1220
msgid "Classes"
msgstr "Osztályok"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2166
msgid "Cleanup exited with code %d"
msgstr "A takarítás %d kóddal fejeződött be"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1253
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2425
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2431
msgid "Clear"
msgstr "Törlés"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2304
msgid "Clear configuration"
msgstr "Beállítások törlése"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2425
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2431
msgid "Clear editor"
msgstr "Szerkesztő ürítése"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1033
msgid "Click to disable autostart"
msgstr "Kattintson az automatikus indítás letiltásához"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1033
msgid "Click to enable autostart"
msgstr "Kattintson az automatikus indítás engedélyezéséhez"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:843
msgid "Common CAKE options"
msgstr "Közös CAKE-beállítások"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:705
msgid "Config"
msgstr "Beállítások"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2329
msgid "Config cleared, qosify stopped."
msgstr "Beállítások törölve, a qosify leállítva."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2329
msgid "Config cleared."
msgstr "Beállítások törölve."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2350
msgid "Config saved"
msgstr "Beállítások mentve"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2477
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2485
msgid "Config: %s"
msgstr "Beállítások: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:666
msgid "Continue"
msgstr "Folytatás"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1454
msgid "Could not read %s: %s"
msgstr "Nem sikerült olvasni: %s: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:708
msgid "Counters"
msgstr "Számlálók"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1659
msgid "Counters reset."
msgstr "Számlálók nullázva."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1636
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2054
