"Bandwidth for both directions, where bandwidth_up or bandwidth_down is not "
"set"
msgstr ""
"Mindkét irány sávszélessége, ahol a bandwidth_up vagy a bandwidth_down nincs "
"beállítva"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:819
msgid "Basic"
msgstr "Alap"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:277
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2464
