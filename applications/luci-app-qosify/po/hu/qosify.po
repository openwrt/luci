msgstr "CAKE bejövő beállítások"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:841
msgid "CAKE ingress options, space separated."
msgstr "CAKE bejövő beállítások, szóközzel elválasztva."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:94
msgid "CAKE options for ingress + egress"
msgstr "CAKE-beállítások a bejövő és kimenő irányhoz"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:87
msgid ""
"CAKE overhead keyword added to options; manual uses overhead and "
"overhead_encap"
msgstr ""
"A beállításokhoz adott CAKE overhead kulcsszó; a manual az overhead és "
"overhead_encap értékeket használja"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:834
msgid "CAKE overhead keyword. Use none if unsure."
msgstr "CAKE overhead kulcsszó. Ha bizonytalan, használja a none értéket."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:664
