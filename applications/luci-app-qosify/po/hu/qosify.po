#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1318
msgid "\"%s\" is not a value qosify accepts for %s."
msgstr "A(z) \"%s\" nem olyan érték, amelyet a qosify elfogad ehhez: %s."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:531
msgid ""
"%d class and alias sections — qosify has %d class slots, so %s and the rules "
"using them are dropped"
msgstr ""
"%d osztály- és álnévszakasz — a qosify %d osztályhelyet kezel, ezért a(z) %s "
"és az ezeket használó szabályok kimaradnak"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:986
msgid "%d interface"
msgid_plural "%d interfaces"
msgstr[0] "%d interfész"
msgstr[1] "%d interfész"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1047
msgid "%d rule"
msgid_plural "%d rules"
msgstr[0] "%d szabály"
msgstr[1] "%d szabály"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1046
msgid "%d section"
msgid_plural "%d sections"
msgstr[0] "%d szakasz"
msgstr[1] "%d szakasz"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:331
msgid ""
"%s \"%s\" is not a tc rate — tc refuses the qdisc, so nothing is shaped "
"although qosify reports the section active"
msgstr ""
"A(z) %s \"%s\" nem tc-sebesség — a tc elutasítja a qdisc-et, így nincs "
"forgalomformálás, bár a qosify aktívnak jelenti a szakaszt"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:335
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:338
msgid "%s \"%s\" is not a whole number — tc refuses the qdisc"
msgstr "A(z) %s \"%s\" nem egész szám — a tc elutasítja a qdisc-et"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:785
msgid "%s (current)"
msgstr "%s (jelenlegi)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:803
msgid "%s (from bandwidth)"
msgstr "%s (a sávszélességből)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2520
msgid ""
"%s and %s are replaced with the templates shipped by the qosify package, and "
"shaping is left disabled."
msgstr ""
"A(z) %s és %s helyére a qosify-csomag sablonjai kerülnek, és a "
"forgalomformálás letiltva marad."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2239
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2263
msgid ""
"%s came back empty although it is %d bytes on disk — refusing to overwrite it"
msgstr ""
"A(z) %s üresen érkezett vissza, pedig a lemezen %d bájt — a felülírás "
"megtagadva"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2783
msgid "%s changed on disk — your unsaved edits are still in the editor."
msgstr ""
"A(z) %s megváltozott a lemezen — a nem mentett módosításai még a "
"szerkesztőben vannak."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2684
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2685
msgid ""
"%s could not be read — the editor is left empty and will not be saved over "
"it."
msgstr "A(z) %s nem olvasható — a szerkesztő üres marad, és nem menti felül."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2268
msgid ""
"%s has changed since this editor was loaded. Saving now discards those "
"changes."
msgstr ""
"A(z) %s megváltozott a szerkesztő betöltése óta. A mentés most elveti ezeket "
"a módosításokat."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2299
msgid ""
"%s is %d bytes on disk but was never loaded into the editor — refusing to "
"truncate it. Reload the page first."
msgstr ""
"A(z) %s a lemezen %d bájt, de soha nem töltődött be a szerkesztőbe — a "
"csonkolás megtagadva. Előbb töltse újra az oldalt."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:431
msgid "%s is a list in this section — edit %s directly"
msgstr ""
"A(z) %s ebben a szakaszban lista — szerkessze közvetlenül a következőt: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2085
msgid ""
"%s is not in the defaults list — qosify does not load it, so the Rules tab "
"has no effect"
msgstr ""
"A(z) %s nincs az alapértelmezések listájában — a qosify nem tölti be, így a "
"Szabályok lapnak nincs hatása"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:437
msgid "%s is not one plain statement in this section — edit %s directly"
msgstr ""
"A(z) %s ebben a szakaszban nem egyetlen egyszerű utasítás — szerkessze "
"közvetlenül a következőt: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:352
msgid ""
"%s is set to \"%s\" — qosify converts it with atoi(), so anything but a non-"
"zero number means off"
msgstr ""
"A(z) %s értéke \"%s\" — a qosify atoi()-val alakítja át, így minden, ami nem "
"nullától eltérő szám, kikapcsolást jelent"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:853
msgid "%s quick settings"
msgstr "%s gyorsbeállítások"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2504
msgid "%s uploaded, qosify reloaded."
msgstr "A(z) %s feltöltve, a qosify újratöltve."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2538
msgid "%s was not written: %s"
msgstr "A(z) %s nem íródott ki: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2541
msgid "%s was reset but %s was not written: %s"
msgstr "A(z) %s visszaállítva, de a(z) %s nem íródott ki: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2380
msgid "%s, applied (QoS disabled)."
msgstr "%s, alkalmazva (QoS letiltva)."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2385
msgid ""
"%s, applied — qosify did not answer on ubus, so shaping could not be checked."
msgstr ""
"%s, alkalmazva — a qosify nem válaszolt az ubuson, így a forgalomformálás "
"nem ellenőrizhető."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2382
msgid "%s, applied."
msgstr "%s, alkalmazva."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:548
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:557
msgid "%s: %s \"%s\" is not a class, codepoint or 0-63 — qosify ignores it"
msgstr ""
"%s: a(z) %s \"%s\" nem osztály, kódpont vagy 0-63 — a qosify figyelmen kívül "
"hagyja"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:545
msgid ""
"%s: %s \"%s\" is not a class, codepoint or 0-63 — qosify rejects the whole "
"config and interface changes are not applied"
msgstr ""
"%s: a(z) %s \"%s\" nem osztály, kódpont vagy 0-63 — a qosify az egész "
"beállítást elutasítja, és az interfészmódosítások nem lépnek életbe"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:554
msgid ""
"%s: %s \"%s\" is not a codepoint or 0-63 — qosify drops this class and the "
"rules using it"
msgstr ""
"%s: a(z) %s \"%s\" nem kódpont vagy 0-63 — a qosify elveti ezt az osztályt "
"és az azt használó szabályokat"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:536
msgid ""
"%s: %s \"%s\" is not a whole number — qosify.init passes it through atoll(), "
"which keeps only the leading digits"
msgstr ""
"%s: a(z) %s \"%s\" nem egész szám — a qosify.init az atoll() függvényen át "
"adja tovább, amely csak a kezdő számjegyeket tartja meg"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:534
msgid ""
"%s: %s cannot be checked — write it as one plain or fully quoted value, with "
"no backslash"
msgstr ""
"%s: a(z) %s nem ellenőrizhető — írja egyetlen egyszerű vagy teljesen "
"idézőjelezett értékként, fordított perjel nélkül"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:540
msgid ""
"%s: %s may only contain letters, digits, spaces, dots, underscores and "
"hyphens — qosify 143d71d (snapshots) drops it otherwise, and 24.10 and 25.12 "
"paste it into a tc command run with sh -c as root"
msgstr ""
"%s: a(z) %s csak betűket, számjegyeket, szóközöket, pontokat, "
"aláhúzásjeleket és kötőjeleket tartalmazhat — különben a qosify 143d71d "
"(pillanatképek) elveti, a 24.10 és a 25.12 pedig egy root jogosultsággal, "
"sh -c útján futó tc-parancsba illeszti"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2084
msgid "%s: multiqueue is set, but %s has one queue, so qosify uses plain cake"
msgstr ""
"%s: a multiqueue be van állítva, de a(z) %s csak egy sorral rendelkezik, "
"ezért a qosify sima cake-et használ"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1215
msgid "(alias)"
msgstr "(álnév)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1367
msgid "(over file)"
msgstr "(felülbírálja a fájlt)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:507
msgid "(this qosify build has no NQB)"
msgstr "(ez a qosify-változat nem tartalmaz NQB-t)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2620
msgid "A config defaults section already exists."
msgstr "Már létezik config defaults szakasz."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2618
msgid "A section name may only contain letters, digits and underscores."
msgstr ""
"A szakasz neve csak betűket, számjegyeket és aláhúzásjelet tartalmazhat."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1415
msgid "Action"
msgstr "Művelet"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:960
msgid "Active"
msgstr "Aktív"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1061
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1269
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1303
msgid "Add"
msgstr "Hozzáadás"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1325
msgid "Add failed: %s"
msgstr "Hozzáadás sikertelen: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1305
msgid ""
"Added to the running qosify at once and not saved: an entry expires after "
"its timeout (the defaults timeout when left empty) and a qosify restart "
"drops it. One on a match from the rules file overrides it until then."
msgstr ""
"Azonnal bekerül a futó qosify-ba, és nem lesz mentve: a bejegyzés az "
"időkorlátja után lejár (üresen hagyva az alapértelmezett időkorláttal), és a "
"qosify újraindítása törli. A szabályfájl egyezésére vonatkozó bejegyzés "
"addig felülbírálja azt."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1273
msgid ""
"Adds a line to the editor below; Save & Apply writes it to the rules file, "
"so it is kept."
msgstr ""
"Egy sort ad a lenti szerkesztőhöz; a Mentés és alkalmazás a szabályfájlba "
"írja, így megmarad."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:89
msgid "Adds atm, noatm or ptm when overhead_type is manual"
msgstr "Hozzáadja az atm, noatm vagy ptm értéket, ha az overhead_type kézi"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:91
msgid "Adds ether-vlan once per level (1 or 2)"
msgstr "Szintenként egyszer hozzáadja az ether-vlan értéket (1 vagy 2)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:90
msgid "Adds mpu <bytes>"
msgstr "Hozzáadja az mpu <bytes> értéket"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:88
msgid "Adds overhead <bytes> when overhead_type is manual"
msgstr "Hozzáadja az overhead <bytes> értéket, ha az overhead_type kézi"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:709
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:840
