msgstr "Gníomh"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:899
msgid "Active"
msgstr "Gníomhach"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1000
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1206
