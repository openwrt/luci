msgid_plural "%d interfaces"
msgstr[0] "%d comhéadan"
msgstr[1] "%d chomhéadan"
msgstr[2] "%d chomhéadan"
msgstr[3] "%d chomhéadan"
msgstr[4] "%d chomhéadan"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:986
msgid "%d rule"
msgid_plural "%d rules"
msgstr[0] "%d riail"
msgstr[1] "%d riail"
msgstr[2] "%d riail"
msgstr[3] "%d riail"
msgstr[4] "%d riail"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:985
msgid "%d section"
msgid_plural "%d sections"
msgstr[0] "%d rannán"
msgstr[1] "%d rannán"
msgstr[2] "%d rannán"
msgstr[3] "%d rannán"
msgstr[4] "%d rannán"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:294
msgid ""
"%s \"%s\" is not a tc rate — tc refuses the qdisc, so nothing is shaped "
"although qosify reports the section active"
msgstr ""
"Ní ráta 'tc' é %s \"%s\" — diúltaíonn 'tc' don qdisc, mar sin ní dhéantar "
"aon mhúnlú, cé go léiríonn 'qosify' go bhfuil an rannán gníomhach"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:298
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:301
msgid "%s \"%s\" is not a whole number — tc refuses the qdisc"
msgstr "Ní uimhir shlán é %s \"%s\" — diúltaíonn tc don qdisc"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:725
msgid "%s (current)"
msgstr "%s (reatha)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:743
msgid "%s (from bandwidth)"
msgstr "%s (ón bandaleithead)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2288
msgid ""
"%s and %s are replaced with the templates shipped by the qosify package, and "
"shaping is left disabled."
msgstr ""
"Cuirtear na teimpléid a sholáthraíonn an pacáiste qosify in áit %s agus %s, "
"agus fágtar an mhúnlú tráchta díchumasaithe."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2012
msgid ""
"%s came back empty although it is %d bytes on disk — refusing to overwrite it"
msgstr ""
"Tháinig %s ar ais folamh cé go bhfuil sé %d beart ar an diosca — ag diúltú é "
"a fhorscríobh"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2549
msgid "%s changed on disk — your unsaved edits are still in the editor."
msgstr ""
"Athraíodh %s ar an diosca — tá do chuid athruithe nár sábháladh fós san "
"eagarthóir."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2452
msgid ""
"%s could not be read — the editor is left empty and will not be saved over "
"it."
msgstr ""
"Níorbh fhéidir %s a léamh — fágadh an t-eagarthóir folamh agus ní shábhálfar "
"aon rud ina áit."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2036
msgid ""
"%s has changed since this editor was loaded. Saving now discards those "
"changes."
msgstr ""
"Tá athrú tagtha ar %s ó luchtú an eagarthóra seo. Má shábhálann tú anois, "
"caillfear na hathruithe sin."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2067
msgid ""
"%s is %d bytes on disk but was never loaded into the editor — refusing to "
"truncate it. Reload the page first."
msgstr ""
"Tá %s %d beart ar an diosca ach níor luchtáladh riamh é sa eagarthóir — á "
"dhiúltú é a ghiorrú. Athluchtaigh an leathanach ar dtús."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:392
msgid "%s is a list in this section — edit %s directly"
msgstr "Is liosta é %s sa rannán seo — cuir %s in eagar go díreach"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1859
msgid ""
"%s is not in the defaults list — qosify does not load it, so the Rules tab "
"has no effect"
msgstr ""
"Níl %s ar an liosta réamhshocruithe — níl sé á luchtú ag qosify, mar sin níl "
"aon éifeacht ag an gcluaisín Rialacha"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:314
msgid ""
"%s is set to \"%s\" — qosify converts it with atoi(), so anything but a non-"
"zero number means off"
msgstr ""
"Tá %s socraithe ar \"%s\" — déanann qosify é a thiontú le atoi(), mar sin "
"ciallaíonn aon rud seachas uimhir neamh-nialasach go bhfuil sé múchta"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:793
msgid "%s quick settings"
msgstr "Socruithe tapa %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2272
msgid "%s uploaded, qosify reloaded."
msgstr "%s uaslódáilte, qosify athlódáilte."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2306
msgid "%s was not written: %s"
msgstr "Níor scríobhadh %s: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2309
msgid "%s was reset but %s was not written: %s"
msgstr "Athshocraíodh %s ach níor scríobhadh %s: %s"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2148
msgid "%s, applied (QoS disabled)."
msgstr "%s, curtha i bhfeidhm (QoS díchumasaithe)."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2153
msgid ""
"%s, applied — qosify did not answer on ubus, so shaping could not be checked."
msgstr ""
"%s, curtha i bhfeidhm — níor thug qosify freagra ar ubus, mar sin níorbh "
"fhéidir an mhúnlú a sheiceáil."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2150
msgid "%s, applied."
msgstr "%s, curtha i bhfeidhm."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:500
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:509
msgid "%s: %s \"%s\" is not a class, codepoint or 0-63 — qosify ignores it"
msgstr ""
"%s: %s Ní aicme, pointe cóid ná luach idir 0 agus 63 é \"%s\" — déanann "
"qosify neamhaird de"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:497
msgid ""
"%s: %s \"%s\" is not a class, codepoint or 0-63 — qosify rejects the whole "
"config and interface changes are not applied"
msgstr ""
"%s: %s Ní rang, pointe cóid ná luach idir 0 agus 63 é \"%s\" — diúltaíonn "
"qosify don chumraíocht ar fad agus ní chuirtear na hathruithe ar an "
"gcomhéadan i bhfeidhm"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:506
msgid ""
"%s: %s \"%s\" is not a codepoint or 0-63 — qosify drops this class and the "
"rules using it"
msgstr ""
"%s: Ní pointe cóid ná luach idir 0 agus 63 é %s \"%s\" — déanann qosify an "
"aicme seo agus na rialacha a bhaineann léi a chaitheamh i leataobh"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:488
msgid ""
"%s: %s \"%s\" is not a whole number — qosify.init passes it through atoll(), "
"which keeps only the leading digits"
msgstr ""
"%s: %s Ní uimhir shlán é \"%s\" — cuireann qosify.init tríd an bhfeidhm atoll"
"() é, rud nach gcoinníonn ach na digití tosaigh"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:486
msgid ""
"%s: %s cannot be checked — write it as one plain or fully quoted value, with "
"no backslash"
msgstr ""
"%s: Ní féidir %s a sheiceáil — scríobh é mar luach simplí amháin nó mar "
"luach atá faoi luíana iomlána, gan aon chúlslais"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:492
msgid ""
"%s: %s contains shell metacharacters — qosify runs the tc command with sh -c "
"as root, so they would break it or be executed"
msgstr ""
"%s: Tá meitea-charachtair bhlaosc i %s — ritheann qosify an t-ordú tc le sh "
"-c mar fhréamh (root), mar sin chuirfeadh siad isteach ar a fheidhmiú nó "
"rithfí iad"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1153
msgid "(alias)"
msgstr "(ainm cleite)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1304
msgid "(over file)"
msgstr "(thar comhad)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:463
msgid "(this qosify build has no NQB)"
msgstr "(níl NQB ag an leagan seo de qosify)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2388
msgid "A config defaults section already exists."
msgstr "Tá rannóg réamhshocruithe cumraíochta ann cheana féin."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2386
msgid "A section name may only contain letters, digits and underscores."
msgstr ""
"Ní fhéadfaidh ach litreacha, digití agus fostí a bheith i n-ainm rannáin."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1352
