msgid "qosify-status returned no output."
msgstr "Níor thug qosify-status aon aschur ar ais."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:918
msgid ""
"rpcd is not answering for qosify — check the ACL in /usr/share/rpcd/acl.d "
