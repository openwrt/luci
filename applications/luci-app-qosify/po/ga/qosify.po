msgstr "Níl qosify ag rith. Tosaigh ón táb Forbhreathnú."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1938
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:2090
msgid "qosify is still running — leaving the qdiscs alone"
msgstr "Tá qosify fós ag rith — na qdiscs á bhfágáil mar atá"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1361
#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1362
