#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1255
msgid "\"%s\" is not a value qosify accepts for %s."
msgstr "Ní luach é \"%s\" a ghlacann qosify le haghaidh %s."

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:483
msgid ""
"%d class and alias sections — qosify has %d class slots, so %s and the rules "
"using them are dropped"
msgstr ""
"%d rannán aicme agus ailias — tá %d sliotán aicme ag qosify, mar sin fágtar "
"%s agus na rialacha a bhaineann úsáid astu ar lár"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:925
