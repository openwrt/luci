msgid "(alias)"
msgstr "(псевдоним)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:1367
msgid "(over file)"
msgstr "(переопределено файлом)"

#: applications/luci-app-qosify/htdocs/luci-static/resources/view/qosify/main.js:507
msgid "(this qosify build has no NQB)"
msgstr "(в этой сборке qosify нет NQB)"

